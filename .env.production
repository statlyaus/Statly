NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production

# Core server configuration
DATABASE_URL=your_production_database_url
NEXTAUTH_URL=https://your-production-domain.com
NEXTAUTH_SECRET=your_super_secure_production_secret
# Optional compatibility alias. Leave unset to derive from NEXTAUTH_SECRET in the deploy script.
# JWT_SECRET=your_super_secure_production_secret

# API configuration
NEXT_PUBLIC_API_URL=https://your-production-api.com

# Firebase Admin credentials. Use one supported shape.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=replace_with_base64_service_account_json
# Or comment the base64 value above and use the explicit triplet:
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Performance monitoring (optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_analytics_id

# Logging level for production
LOG_LEVEL=error

# Safety: keep auth bypass disabled in production.
BYPASS_AUTH=false
NEXT_PUBLIC_BYPASS_AUTH=false
