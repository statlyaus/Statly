# Production Environment Configuration
# Populate these values with your Firebase PRODUCTION project details.

# Public client config (browser)
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_PRODUCTION_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-production-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-production-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-production-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=PRODUCTION_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=PRODUCTION_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-PRODUCTIONXXXX
NEXT_PUBLIC_USE_EMULATORS=false

# Server (admin) config
# Base64-encoded service account JSON for PRODUCTION
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=YOUR_PRODUCTION_SERVICE_ACCOUNT_BASE64

INTERNAL_TASK_SECRET=YOUR_PRODUCTION_INTERNAL_TASK_SECRET
LOG_LEVEL=warn
LEAGUE_REVALIDATE_SECONDS=1800

# JWT Secret for authentication (generate a unique one for production)
JWT_SECRET=YOUR_PRODUCTION_JWT_SECRET

# Prisma database URL for PRODUCTION
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# Redis configuration for PRODUCTION
REDIS_HOST=your-production-redis-host
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=YOUR_PRODUCTION_REDIS_PASSWORD
REDIS_DB=0
