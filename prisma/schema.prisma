generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  timeZone     String   @default("UTC")
  leagues      LeagueMember[]
  sessions     Session[]
  createdAt    DateTime @default(now())
  tradesProposed Trade[] @relation("TradeProposer")
  tradesReceived Trade[] @relation("TradeRecipient")
  tradeItemsSent TradeItem[] @relation("TradeItemFromUser")
  tradeItemsReceived TradeItem[] @relation("TradeItemToUser")
  tradeAudits TradeAudit[]
  tradeActions TradeAction[]

  @@index([email])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  jwtId     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model League {
  id            String   @id @default(cuid())
  name          String
  inviteCode    String   @unique
  ownerId       String
  settingsId    String   @unique
  members       LeagueMember[]
  rosterPlayers LeagueRosterPlayer[]
  settings      LeagueSettings @relation(fields: [settingsId], references: [id])
  drafts        Draft[]
  trades        Trade[]
  createdAt     DateTime @default(now())

  @@index([ownerId])
  @@index([createdAt])
  @@index([inviteCode])
}

model LeagueMember {
  id        String  @id @default(cuid())
  leagueId  String
  userId    String
  role      LeagueRole
  teamName  String
  draftSlot Int?
  joinedAt  DateTime @default(now())
  league    League  @relation(fields: [leagueId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
  picks     Pick[]
  orders    DraftOrder[]
  rosterPlayers LeagueRosterPlayer[]

  // Lobby relations
  watchlists   DraftWatchlist[]
  preDraftQueues PreDraftQueue[]
  lobbyActivities LobbyActivity[]

  @@index([leagueId])
  @@index([userId])
  @@index([leagueId, userId])
  @@index([draftSlot])
}

enum LeagueRole { 
  OWNER 
  MANAGER 
}

model LeagueSettings {
  id              String  @id @default(cuid())
  rosterSize      Int
  benchSize       Int
  maxTeams        Int
  pickSeconds     Int
  allowAutoPick   Boolean @default(true)
  draftType       DraftType
  startAt         DateTime
  timeZone        String   @default("UTC")
  locked          Boolean  @default(false)
  
  // Captain/Vice-Captain system (admin configurable)
  enableCaptainSystem Boolean @default(false)
  captainMultiplier   Float   @default(2.0)
  viceCaptainMultiplier Float @default(1.5)
  
  league          League?
}

enum DraftType { 
  SNAKE 
}

model Draft {
  id           String   @id @default(cuid())
  leagueId     String   @unique
  league       League   @relation(fields: [leagueId], references: [id])
  status       DraftStatus
  currentPick  Int      @default(1)
  totalPicks   Int
  round        Int      @default(1)
  direction    DraftDirection @default(FORWARD)
  picks        Pick[]
  orders       DraftOrder[]
  createdAt    DateTime @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  // Version counter used to atomically claim scheduling of the next pick
  schedulingVersion Int @default(0)

  // Lobby system fields
  lobbyStatus  String?  @default("CLOSED")
  lobbyOpenAt  DateTime?

  // Lobby relations
  watchlists   DraftWatchlist[]
  preDraftQueues PreDraftQueue[]
  lobbyActivities LobbyActivity[]

  @@index([status])
  @@index([leagueId])
  @@index([createdAt])
  @@index([leagueId, status])
}

enum DraftStatus { 
  SCHEDULED 
  LIVE 
  PAUSED 
  COMPLETED 
}

enum DraftDirection {
  FORWARD
  REVERSE
}

enum TradeStatus {
  PROPOSED
  DECLINED
  CANCELLED
  SUPERSEDED
  EXPIRED
  EXECUTED
}

enum TradeEvent {
  TRADE_PROPOSED
  TRADE_COUNTERED
  TRADE_DECLINED
  TRADE_CANCELLED
  TRADE_ACCEPTED
  TRADE_EXECUTED
  TRADE_FAILED
}

enum TradeErrorCode {
  TRADE_WINDOW_CLOSED
  TRADE_NOT_FOUND
  TRADE_FORBIDDEN
  TRADE_INVALID_TRANSITION
  TRADE_PLAYER_NOT_OWNED
  TRADE_ROSTER_INVALID
  TRADE_PLAYER_LOCKED
  TRADE_IDEMPOTENCY_CONFLICT
}

enum TradeActionType {
  ACCEPT
  DECLINE
  CANCEL
}

model DraftWatchlist {
  id        String   @id @default(cuid())
  draftId   String
  memberId  String
  playerId  String
  priority  Int      @default(1)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  draft  Draft        @relation(fields: [draftId], references: [id], onDelete: Cascade)
  member LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  player Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([draftId, memberId, playerId])
  @@index([draftId, memberId])
  @@index([playerId])
}

model PreDraftQueue {
  id        String   @id @default(cuid())
  draftId   String
  memberId  String
  playerId  String
  rank      Int
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  draft  Draft        @relation(fields: [draftId], references: [id], onDelete: Cascade)
  member LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  player Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([draftId, memberId, playerId])
  @@index([draftId, memberId])
  @@index([rank])
}

model LobbyActivity {
  id        String   @id @default(cuid())
  draftId   String
  memberId  String
  action    String
  details   String?  // JSON string
  timestamp DateTime @default(now())

  draft  Draft        @relation(fields: [draftId], references: [id], onDelete: Cascade)
  member LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([draftId, timestamp])
}

model DraftOrder {
  id         String  @id @default(cuid())
  draftId    String
  slot       Int
  memberId   String
  member     LeagueMember @relation(fields: [memberId], references: [id])
  draft      Draft @relation(fields: [draftId], references: [id])
  
  @@unique([draftId, slot])
}

model Player {
  id       String  @id
  name     String
  club     String
  position String
  active   Boolean @default(true)
  picks    Pick[]
  rosterPlayers LeagueRosterPlayer[]
  tradeItems TradeItem[]
  tradeLocks TradePlayerLock[]

  // Lobby relations
  watchlists   DraftWatchlist[]
  preDraftQueues PreDraftQueue[]

  @@index([name])
}

model Pick {
  id         String  @id @default(cuid())
  draftId    String
  overall    Int
  round      Int
  slot       Int
  memberId   String
  playerId   String
  madeAt     DateTime @default(now())
  auto       Boolean  @default(false)
  draft      Draft @relation(fields: [draftId], references: [id])
  member     LeagueMember @relation(fields: [memberId], references: [id])
  player     Player @relation(fields: [playerId], references: [id])

  @@unique([draftId, playerId])
  @@unique([draftId, overall])
  @@index([draftId])
  @@index([memberId])
  @@index([playerId])
  @@index([overall])
  @@index([madeAt])
}

model QueueItem {
  id        String  @id @default(cuid())
  memberId  String
  playerId  String
  rank      Int
  
  @@unique([memberId, playerId])
  @@unique([memberId, rank])
}

// League Roster Management
model LeagueRoster {
  id          String   @id @default(cuid())
  leagueId    String
  memberId    String
  playerIds   String   // JSON array of player IDs
  captainId   String?  // Player ID of captain
  viceCaptainId String? // Player ID of vice-captain
  benchOrder  String?  // JSON array for bench ordering
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([leagueId, memberId])
  @@index([leagueId])
  @@index([memberId])
}

model LeagueRosterPlayer {
  id        String   @id @default(cuid())
  leagueId  String
  memberId  String
  playerId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  member LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([leagueId, memberId, playerId])
  @@index([leagueId])
  @@index([memberId])
  @@index([playerId])
}

// Team Actions (trades, waivers, etc.)
model TeamAction {
  id          String   @id @default(cuid())
  leagueId    String
  memberId    String
  actionType  TeamActionType
  status      ActionStatus @default(PENDING)
  details     String   // JSON details specific to action type
  targetMemberId String? // For trades
  processingAt DateTime?
  processedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([leagueId, status])
  @@index([memberId])
  @@index([actionType])
  @@index([processingAt])
}

enum TeamActionType {
  TRADE_PROPOSAL
  WAIVER_CLAIM
  DROP_PLAYER
  SET_CAPTAIN
  SET_VICE_CAPTAIN
  OPTIMIZE_LINEUP
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
  CANCELLED
}

model Trade {
  id                  String     @id @default(cuid())
  leagueId            String
  roundId             String?
  proposerUserId      String
  recipientUserId     String
  status              TradeStatus
  requestId           String
  requestPayloadHash  String
  parentTradeId       String?
  supersededByTradeId String?
  note                String?
  createdAt           DateTime   @default(now())
  executedAt          DateTime?

  league        League @relation(fields: [leagueId], references: [id])
  proposerUser  User   @relation("TradeProposer", fields: [proposerUserId], references: [id])
  recipientUser User   @relation("TradeRecipient", fields: [recipientUserId], references: [id])

  items   TradeItem[]
  audit   TradeAudit[]
  actions TradeAction[]
  locks   TradePlayerLock[]

  @@unique([requestId, proposerUserId])
  @@unique([parentTradeId])
  @@unique([supersededByTradeId])
  @@index([leagueId, status, createdAt])
  @@index([proposerUserId, status, createdAt])
  @@index([recipientUserId, status, createdAt])
  @@index([parentTradeId])
  @@index([supersededByTradeId])
}

model TradeItem {
  id         String   @id @default(cuid())
  tradeId    String
  fromUserId String
  toUserId   String
  playerId   String
  createdAt  DateTime @default(now())

  trade    Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  fromUser User   @relation("TradeItemFromUser", fields: [fromUserId], references: [id])
  toUser   User   @relation("TradeItemToUser", fields: [toUserId], references: [id])
  player   Player @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([tradeId, playerId])
  @@index([playerId])
  @@index([tradeId])
}

model TradePlayerLock {
  playerId  String   @id
  tradeId   String
  createdAt DateTime @default(now())

  trade  Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([tradeId])
}

model TradeAudit {
  id          String         @id @default(cuid())
  tradeId     String
  event       TradeEvent
  actorUserId String
  payloadJson Json
  errorCode   TradeErrorCode?
  createdAt   DateTime       @default(now())

  trade     Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  actorUser User  @relation(fields: [actorUserId], references: [id])

  @@index([tradeId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([event])
}

model TradeAction {
  id          String          @id @default(cuid())
  tradeId     String
  action      TradeActionType
  requestId   String
  actorUserId String
  createdAt   DateTime        @default(now())

  trade     Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  actorUser User  @relation(fields: [actorUserId], references: [id])

  @@unique([requestId])
  @@unique([tradeId, action])
  @@index([tradeId, createdAt])
  @@index([actorUserId, createdAt])
}
