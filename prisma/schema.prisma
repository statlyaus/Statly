generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  timeZone     String   @default("UTC")
  createdAt    DateTime @default(now())
  /// Auth secret storage only — never `include` from API-facing queries.
  credential   UserCredential?
  leagues      LeagueMember[]
  sessions     Session[]
  tradesProposed Trade[] @relation("TradeProposer")
  tradesReceived Trade[] @relation("TradeRecipient")
  tradeItemsSent TradeItem[] @relation("TradeItemFromUser")
  tradeItemsReceived TradeItem[] @relation("TradeItemToUser")
  tradeAudits TradeAudit[]
  tradeActions TradeAction[]
  tradeReviewVotes TradeReviewVote[]
  ownedLeagues     League[] @relation("LeagueOwner")

  @@index([createdAt])
}

model UserCredential {
  userId       String   @id
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  jwtId     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model League {
  id            String   @id @default(cuid())
  name          String
  inviteCode    String   @unique
  type          String   @default("private")
  ownerId       String
  owner         User     @relation("LeagueOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  description   String?
  status        String   @default("preseason")
  categoriesJson String?
  draftDate     DateTime?
  tradeLimit    Int      @default(10)
  tradeReview   String   @default("none")
  /// Hours the league veto review window stays open after both managers accept (veto mode only).
  tradeVetoPeriodHours Int @default(24)
  tradeDeadline DateTime?
  waiverOrderJson String?
  waiverPeriodHours Int  @default(24)
  waiverResetPolicy String @default("weekly")
  waiverSystem String @default("ROLLING_LIST")
  waiverPriorityMode String @default("ROLLING")
  waiverFaabBudget Int?
  waiverMinimumBid Int @default(1)
  waiverMaxWeekAcquisitions Int?
  waiverMaxSeasonAcquisitions Int?
  waiverMoveWinnerToBack Boolean @default(true)
  waiverAcquisitionLocked Boolean @default(false)
  cantDropListJson String?
  settingsId    String   @unique
  members       LeagueMember[]
  rosterPlayers LeagueRosterPlayer[]
  rosterSummaries LeagueRosterPlayerSummary[]
  rosters       LeagueRoster[]
  teamActions   TeamAction[]
  waiverClaims  WaiverClaim[]
  waiverPriorities WaiverPriority[]
  botProfiles   LeagueBotProfile[]
  settings      LeagueSettings @relation(fields: [settingsId], references: [id])
  drafts        Draft[]
  draftEvents   DraftEvent[]
  trades        Trade[]
  createdAt     DateTime @default(now())

  @@index([ownerId])
  @@index([createdAt])
}

model LeagueMember {
  id        String  @id @default(cuid())
  leagueId  String
  userId    String
  role      LeagueRole
  teamName  String
  draftSlot Int?
  joinedAt  DateTime @default(now())
  league    League  @relation(fields: [leagueId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
  picks     Pick[]
  orders    DraftOrder[]
  rosterPlayers LeagueRosterPlayer[]
  rosterSummaries LeagueRosterPlayerSummary[]

  // Lobby relations
  watchlists   DraftWatchlist[]
  preDraftQueues PreDraftQueue[]
  lobbyActivities LobbyActivity[]
  rosters        LeagueRoster[]
  teamActions    TeamAction[]
  waiverClaims   WaiverClaim[]
  waiverPriority WaiverPriority?
  botProfile     LeagueBotProfile?

  @@unique([leagueId, userId])
  @@index([leagueId])
  @@index([userId])
  @@index([draftSlot])
}

enum LeagueRole { 
  OWNER 
  COMMISSIONER
  MANAGER 
}

enum BotPersonality {
  BALANCED
  AGGRESSIVE
  OPPORTUNISTIC
  CONSERVATIVE
  WAIVER_HUNTER
}

model LeagueSettings {
  id              String  @id @default(cuid())
  rosterSize      Int
  benchSize       Int
  maxTeams        Int
  pickSeconds     Int
  allowAutoPick   Boolean @default(true)
  enableDraftReminders Boolean @default(true)
  draftType       DraftType
  startAt         DateTime
  timeZone        String   @default("UTC")
  locked          Boolean  @default(false)

  // Season and playoff configuration
  seasonWeeks     Int      @default(12)
  matchupsPerOpponent Int  @default(1)
  playoffsEnabled Boolean  @default(false)
  playoffTeams    Int      @default(0)
  playoffLegLengthWeeks Int @default(1)
  playoffReseedEachRound Boolean @default(false)
  playoffIncludeConsolation Boolean @default(false)
  
  // Captain/Vice-Captain system (admin configurable)
  enableCaptainSystem Boolean @default(false)
  captainMultiplier   Float   @default(2.0)
  viceCaptainMultiplier Float @default(1.5)
  
  league          League?
}

enum DraftType { 
  SNAKE
  LINEAR
}

model Draft {
  id           String   @id @default(cuid())
  leagueId     String   @unique
  league       League   @relation(fields: [leagueId], references: [id])
  status       DraftStatus
  currentPick  Int      @default(1)
  totalPicks   Int
  round        Int      @default(1)
  direction    DraftDirection @default(FORWARD)
  picks        Pick[]
  orders       DraftOrder[]
  createdAt    DateTime @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  pickStartedAt DateTime?
  pickDeadlineAt DateTime?
  pausedRemainingSeconds Int?
  // Version counter used to atomically claim scheduling of the next pick
  schedulingVersion Int @default(0)

  // Lobby system fields
  lobbyStatus  String?  @default("CLOSED")
  lobbyOpenAt  DateTime?

  // Lobby relations
  watchlists   DraftWatchlist[]
  preDraftQueues PreDraftQueue[]
  lobbyActivities LobbyActivity[]
  events       DraftEvent[]

  @@index([status])
  @@index([leagueId])
  @@index([createdAt])
  @@index([leagueId, status])
}

model DraftEvent {
  id           String   @id @default(cuid())
  draftId       String
  leagueId      String
  event         String
  payload       String?
  publishState  Boolean  @default(false)
  attempts      Int      @default(0)
  lastError     String?
  lockedAt      DateTime?
  lockedBy      String?
  publishedAt   DateTime?
  createdAt     DateTime @default(now())

  draft  Draft  @relation(fields: [draftId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@index([draftId, createdAt])
  @@index([leagueId, createdAt])
  @@index([lockedAt, createdAt])
  @@index([publishedAt, createdAt])
}

enum DraftStatus { 
  SCHEDULED 
  LIVE 
  PAUSED 
  COMPLETED 
}

enum DraftDirection {
  FORWARD
  REVERSE
}

enum TradeStatus {
  PROPOSED
  REVIEW_PENDING
  DECLINED
  REVIEW_REJECTED
  CANCELLED
  SUPERSEDED
  EXPIRED
  EXECUTED
}

enum TradeEvent {
  TRADE_PROPOSED
  TRADE_COUNTERED
  TRADE_REVIEW_REQUESTED
  TRADE_REVIEW_VOTE_CAST
  TRADE_REVIEW_APPROVED
  TRADE_REVIEW_REJECTED
  TRADE_DECLINED
  TRADE_CANCELLED
  TRADE_ACCEPTED
  TRADE_EXECUTED
  TRADE_FAILED
}

enum TradeErrorCode {
  TRADE_WINDOW_CLOSED
  TRADE_NOT_FOUND
  TRADE_FORBIDDEN
  TRADE_INVALID_PAYLOAD
  TRADE_INVALID_TRANSITION
  TRADE_PLAYER_NOT_OWNED
  TRADE_ROSTER_INVALID
  TRADE_PLAYER_LOCKED
  TRADE_LIMIT_REACHED
  TRADE_IDEMPOTENCY_CONFLICT
}

enum TradeActionType {
  ACCEPT
  DECLINE
  CANCEL
}

enum TradeReviewMode {
  NONE
  ADMIN
  VETO
}

enum TradeReviewStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum TradeReviewVoteType {
  APPROVE
  VETO
}

enum PlayerAliasSource {
  MANUAL
  FIRESTORE_SYNC
  ETL_DISCOVERY
}

enum UnresolvedPlayerStatStatus {
  NEW
  REVIEWED
  RESOLVED
  DISMISSED
}

model DraftWatchlist {
  id        String   @id @default(cuid())
  draftId   String
  memberId  String
  playerId  String
  priority  Int      @default(1)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  draft  Draft        @relation(fields: [draftId], references: [id], onDelete: Cascade)
  member LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  player Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([draftId, memberId, playerId])
  @@index([draftId, memberId])
  @@index([playerId])
}

model PreDraftQueue {
  id        String   @id @default(cuid())
  draftId   String
  memberId  String
  playerId  String
  rank      Int
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  draft  Draft        @relation(fields: [draftId], references: [id], onDelete: Cascade)
  member LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  player Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([draftId, memberId, playerId])
  @@unique([draftId, memberId, rank])
  @@index([draftId, memberId])
  @@index([rank])
}

model LobbyActivity {
  id        String   @id @default(cuid())
  draftId   String
  memberId  String
  action    String
  details   String?  // JSON string
  timestamp DateTime @default(now())

  draft  Draft        @relation(fields: [draftId], references: [id], onDelete: Cascade)
  member LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([draftId, timestamp])
}

model DraftOrder {
  id         String  @id @default(cuid())
  draftId    String
  slot       Int
  memberId   String
  member     LeagueMember @relation(fields: [memberId], references: [id])
  draft      Draft @relation(fields: [draftId], references: [id])

  @@unique([draftId, slot])
  @@index([draftId, memberId])
}

model Player {
  id       String  @id
  name     String
  club     String
  position String
  active   Boolean @default(true)
  aliases  PlayerAlias[]
  seasonRegistrations PlayerSeasonRegistration[]
  unresolvedStatRows UnresolvedPlayerStatRow[] @relation("ResolvedPlayerStatRow")
  seasonSummaries PlayerSeasonSummary[]
  recentFormSummaries PlayerRecentFormSummary[]
  latestSnapshots PlayerLatestSnapshot[]
  matchLogProjections PlayerMatchLogProjection[]
  rankingSnapshots PlayerRankingSnapshot[]
  rosterSummaries LeagueRosterPlayerSummary[]
  picks    Pick[]
  rosterPlayers LeagueRosterPlayer[]
  tradeItems TradeItem[]
  tradeLocks TradePlayerLock[]
  waiverClaims WaiverClaim[] @relation("WaiverClaimPlayer")
  droppedByClaims WaiverClaim[] @relation("WaiverDropPlayer")

  // Lobby relations
  watchlists   DraftWatchlist[]
  preDraftQueues PreDraftQueue[]

  leagueRosterAsCaptain     LeagueRoster[] @relation("LeagueRosterCaptain")
  leagueRosterAsViceCaptain LeagueRoster[] @relation("LeagueRosterViceCaptain")

  @@index([name])
  @@index([club])
  @@index([position])
  @@index([active])
}

model PlayerAlias {
  id                  String            @id @default(cuid())
  playerId            String
  aliasName           String
  normalizedAliasName String
  club                String?
  normalizedClub      String?
  scopeKey            String            @default("all:all:global")
  source              PlayerAliasSource @default(MANUAL)
  seasonFrom          Int?
  seasonTo            Int?
  confidence          Float             @default(1)
  approvedBy          String?
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([normalizedAliasName])
  @@index([normalizedAliasName, normalizedClub])
  @@index([scopeKey])
  @@index([seasonFrom, seasonTo])
  @@unique([normalizedAliasName, scopeKey])
  @@unique([playerId, normalizedAliasName, normalizedClub, seasonFrom, seasonTo])
}

model PlayerSeasonRegistration {
  id             String            @id @default(cuid())
  playerId       String
  season         Int
  club           String
  normalizedClub String
  position       String
  listStatus     String            @default("active")
  active         Boolean           @default(true)
  source         PlayerAliasSource @default(MANUAL)
  approvedBy     String?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season, normalizedClub])
  @@index([season, normalizedClub])
  @@index([playerId, season])
  @@index([season, active])
}

model UnresolvedPlayerStatRow {
  id                  String                   @id @default(cuid())
  source              String
  sourceDocumentId    String
  sourceMatchId       String?
  season              Int
  round               Int?
  playerName          String
  normalizedPlayerName String
  team                String?
  normalizedTeam      String?
  status              UnresolvedPlayerStatStatus @default(NEW)
  rawPayloadJson      String
  candidatePlayerIdsJson String?
  resolutionNotes     String?
  resolvedPlayerId    String?
  resolvedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  resolvedPlayer Player? @relation("ResolvedPlayerStatRow", fields: [resolvedPlayerId], references: [id], onDelete: SetNull)

  @@unique([source, sourceDocumentId])
  @@index([season, status])
  @@index([normalizedPlayerName, normalizedTeam])
  @@index([resolvedPlayerId])
}

model PlayerSeasonSummary {
  id           String   @id
  playerId      String
  season        Int
  playerName    String
  club          String
  position      String
  gamesPlayed   Int      @default(0)
  averageScore  Float    @default(0)
  totalValue    Float    @default(0)
  statsJson     String
  totalsJson    String
  sourceUpdatedAt DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season])
  @@index([season])
  @@index([season, totalValue])
  @@index([season, club])
  @@index([season, position])
}

model PlayerRankingSnapshot {
  id           String   @id
  season       Int
  scope        String   @default("season")
  method       String   @default("weighted_score_legacy")
  methodVersion Int     @default(1)
  rank         Int
  playerId     String
  playerName   String
  club         String
  position     String
  gamesPlayed  Int      @default(0)
  averageScore Float    @default(0)
  totalValue   Float    @default(0)
  rankingValue Float    @default(0)
  minimumGames Int      @default(0)
  populationSize Int    @default(0)
  isSmallSample Boolean @default(false)
  categoriesJson String
  statsJson    String
  totalsJson   String
  metadataJson String?
  snapshotAt   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([season, scope, method, methodVersion, rank])
  @@unique([season, scope, method, methodVersion, playerId])
  @@index([season, scope, method, methodVersion, rankingValue])
  @@index([season, scope, method, methodVersion, playerId])
}

model PlayerProjectionPublication {
  id            String   @id
  season        Int
  scope         String   @default("season")
  summaryCount  Int      @default(0)
  rankingCount  Int      @default(0)
  rosterCount   Int      @default(0)
  rankingMethod String   @default("weighted_score_legacy")
  rankingMethodVersion Int @default(1)
  rankingMinimumGames Int  @default(0)
  rankingPopulationSize Int @default(0)
  rankingsDirty Boolean  @default(false)
  rankingPublishedAt DateTime?
  rankingMetadataJson String?
  rostersDirty Boolean   @default(false)
  rosterPublishedAt DateTime?
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([season, scope])
  @@index([scope, season])
  @@index([scope, publishedAt])
}

model PlayerRecentFormSummary {
  id             String   @id
  playerId       String
  season         Int
  window         String
  gamesIncluded  Int      @default(0)
  averageScore   Float    @default(0)
  totalValue     Float    @default(0)
  statsJson      String
  totalsJson     String
  sourceUpdatedAt DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season, window])
  @@index([season, window, totalValue])
  @@index([playerId, season])
}

model PlayerLatestSnapshot {
  id              String   @id
  playerId        String
  season          Int
  matchUid        String?
  round           Int?
  statSource      String   @default("projection")
  isLive          Boolean  @default(false)
  lastSeenAt      DateTime?
  averageScore    Float    @default(0)
  totalValue      Float    @default(0)
  statsJson       String
  totalsJson      String
  sourceUpdatedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season])
  @@index([season, isLive, sourceUpdatedAt])
  @@index([matchUid, isLive])
}

model PlayerMatchLogProjection {
  id              String   @id
  playerId        String
  season          Int
  roundNumber     Int
  matchId         String
  matchDate       String
  opponent        String
  statsJson       String
  sourceUpdatedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season, matchId])
  @@index([playerId, season, roundNumber])
  @@index([playerId, season, matchDate])
  @@index([season, roundNumber, matchDate])
}

model LeagueRosterPlayerSummary {
  id             String   @id
  leagueId        String
  memberId        String
  playerId        String
  season          Int
  sortOrder       Int      @default(0)
  playerName      String
  club            String
  position        String
  ownership       Int      @default(0)
  isCaptain       Boolean  @default(false)
  isViceCaptain   Boolean  @default(false)
  gamesPlayed     Int      @default(0)
  averageScore    Float    @default(0)
  totalValue      Float    @default(0)
  price           Int      @default(0)
  lastGameScore   Float    @default(0)
  projectedScore  Float    @default(0)
  formJson        String
  statsJson       String
  totalsJson      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  member LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([leagueId, memberId, playerId, season])
  @@index([leagueId, memberId, season, sortOrder])
  @@index([leagueId, season, playerId])
  @@index([memberId, season])
}

model Pick {
  id         String  @id @default(cuid())
  draftId    String
  overall    Int
  round      Int
  slot       Int
  memberId   String
  playerId   String
  madeAt     DateTime @default(now())
  auto       Boolean  @default(false)
  draft      Draft @relation(fields: [draftId], references: [id])
  member     LeagueMember @relation(fields: [memberId], references: [id])
  player     Player @relation(fields: [playerId], references: [id])

  @@unique([draftId, playerId])
  @@unique([draftId, overall])
  @@index([draftId])
  @@index([memberId])
  @@index([playerId])
  @@index([overall])
  @@index([madeAt])
}

// League Roster Management
model LeagueRoster {
  id          String   @id @default(cuid())
  leagueId    String
  memberId    String
  captainId   String?
  viceCaptainId String?
  benchOrder  String?  // JSON array for bench ordering
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  league      League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  member      LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  captain     Player?      @relation("LeagueRosterCaptain", fields: [captainId], references: [id], onDelete: SetNull)
  viceCaptain Player?      @relation("LeagueRosterViceCaptain", fields: [viceCaptainId], references: [id], onDelete: SetNull)

  @@unique([leagueId, memberId])
  @@index([leagueId])
  @@index([memberId])
}

model LeagueRosterPlayer {
  id        String   @id @default(cuid())
  leagueId  String
  memberId  String
  playerId  String
  sortOrder Int      @default(0) // preserves lineup order (0 = first)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  member LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([leagueId, memberId, playerId])
  @@index([leagueId])
  @@index([memberId])
  @@index([playerId])
  @@index([leagueId, memberId, sortOrder])
}

model LeagueBotProfile {
  id                     String         @id @default(cuid())
  leagueId               String
  memberId               String         @unique
  personality            BotPersonality @default(BALANCED)
  enabled                Boolean        @default(true)
  allowTradeInitiation   Boolean        @default(true)
  allowTradeResponses    Boolean        @default(true)
  allowWaiverClaims      Boolean        @default(true)
  activityLevel          Int            @default(50)
  tradeAggression        Int            @default(50)
  tradeRiskTolerance     Int            @default(50)
  waiverAggression       Int            @default(50)
  preferredTradeCount    Int            @default(1)
  minimumActionIntervalMins Int         @default(180)
  lastAutomatedAt        DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  member LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([leagueId, memberId])
  @@index([leagueId, enabled])
  @@index([memberId, enabled])
}

// Team Actions (trades, waivers, etc.)
model TeamAction {
  id          String   @id @default(cuid())
  leagueId    String
  memberId    String
  actionType  TeamActionType
  status      ActionStatus @default(PENDING)
  details     String   // JSON details specific to action type
  targetMemberId String? // For trades
  processingAt DateTime?
  processedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  league League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  member LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([leagueId, status])
  @@index([memberId])
  @@index([actionType])
  @@index([processingAt])
}

model WaiverClaim {
  id           String   @id @default(cuid())
  leagueId      String
  memberId      String
  playerId      String
  dropPlayerId  String?
  priority      Int      @default(1)
  bidAmount     Int?
  status        WaiverClaimStatus @default(PENDING)
  reason        String?
  processingAt  DateTime?
  processedAt   DateTime?
  cancelledByUserId String?
  cancelledAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  league        League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  member        LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  player        Player      @relation("WaiverClaimPlayer", fields: [playerId], references: [id], onDelete: Restrict)
  dropPlayer    Player?     @relation("WaiverDropPlayer", fields: [dropPlayerId], references: [id], onDelete: Restrict)

  @@index([leagueId, status, createdAt])
  @@index([memberId, status, createdAt])
  @@index([playerId, status, createdAt])
  @@index([processingAt])
}

model WaiverPriority {
  id              String   @id @default(cuid())
  leagueId         String
  memberId         String   @unique
  currentPriority  Int?
  remainingFaab    Int?
  pendingBidTotal  Int      @default(0)
  lastClaimDate    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  league           League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  member           LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([leagueId, memberId])
  @@index([leagueId, currentPriority])
}

enum TeamActionType {
  TRADE_PROPOSAL
  WAIVER_CLAIM
  DROP_PLAYER
  SET_CAPTAIN
  SET_VICE_CAPTAIN
  OPTIMIZE_LINEUP
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
  CANCELLED
}

enum WaiverClaimStatus {
  PENDING
  SUCCESSFUL
  FAILED
  CANCELLED
}

model Trade {
  id                  String     @id @default(cuid())
  leagueId            String
  roundId             String?
  proposerUserId      String
  recipientUserId     String
  status              TradeStatus
  requestId           String
  requestPayloadHash  String
  parentTradeId       String?
  supersededByTradeId String?
  note                String?
  createdAt           DateTime   @default(now())
  acceptedAt          DateTime?
  executedAt          DateTime?
  reviewMode          TradeReviewMode   @default(NONE)
  reviewStatus        TradeReviewStatus @default(NOT_REQUIRED)
  reviewRequestedAt   DateTime?
  reviewWindowEndsAt  DateTime?
  reviewDecidedAt     DateTime?
  proposerViewedAt    DateTime?
  recipientViewedAt   DateTime?

  league        League @relation(fields: [leagueId], references: [id])
  proposerUser  User   @relation("TradeProposer", fields: [proposerUserId], references: [id])
  recipientUser User   @relation("TradeRecipient", fields: [recipientUserId], references: [id])

  items   TradeItem[]
  audit   TradeAudit[]
  actions TradeAction[]
  locks   TradePlayerLock[]
  reviewVotes TradeReviewVote[]

  @@unique([requestId, proposerUserId])
  @@unique([parentTradeId])
  @@unique([supersededByTradeId])
  @@index([leagueId, status, createdAt])
  @@index([proposerUserId, status, createdAt])
  @@index([recipientUserId, status, createdAt])
  @@index([parentTradeId])
  @@index([supersededByTradeId])
}

model TradeItem {
  id         String   @id @default(cuid())
  tradeId    String
  fromUserId String
  toUserId   String
  playerId   String
  createdAt  DateTime @default(now())

  trade    Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  fromUser User   @relation("TradeItemFromUser", fields: [fromUserId], references: [id])
  toUser   User   @relation("TradeItemToUser", fields: [toUserId], references: [id])
  player   Player @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([tradeId, playerId])
  @@index([playerId])
  @@index([tradeId])
}

model TradePlayerLock {
  leagueId  String
  playerId  String
  tradeId   String
  createdAt DateTime @default(now())

  trade  Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([leagueId, playerId])
  @@index([tradeId])
  @@index([leagueId, tradeId])
}

model TradeAudit {
  id          String         @id @default(cuid())
  tradeId     String
  event       TradeEvent
  actorUserId String
  payloadJson Json
  errorCode   TradeErrorCode?
  createdAt   DateTime       @default(now())

  trade     Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  actorUser User  @relation(fields: [actorUserId], references: [id])

  @@index([tradeId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([event])
}

model TradeReviewVote {
  id          String             @id @default(cuid())
  tradeId     String
  voterUserId String
  voteType    TradeReviewVoteType
  createdAt   DateTime           @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  voter User  @relation(fields: [voterUserId], references: [id])

  @@unique([tradeId, voterUserId])
  @@index([tradeId, createdAt])
  @@index([voterUserId, createdAt])
}

model TradeAction {
  id          String          @id @default(cuid())
  tradeId     String
  action      TradeActionType
  requestId   String
  actorUserId String
  createdAt   DateTime        @default(now())

  trade     Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  actorUser User  @relation(fields: [actorUserId], references: [id])

  @@unique([requestId])
  @@unique([tradeId, action])
  @@index([tradeId, createdAt])
  @@index([actorUserId, createdAt])
}
