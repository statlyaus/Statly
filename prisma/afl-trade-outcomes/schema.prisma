generator client {
  provider      = "prisma-client-js"
  output        = "../../src/generated/aflTradeOutcomesPrisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource outcomes {
  provider = "postgresql"
  url      = env("AFL_OUTCOMES_DATABASE_URL")
}

enum OutcomeArtifactClass {
  raw_source
  capture_metadata
  derived_private
  public_projection
}

enum OutcomeEnvironment {
  test_fixture
  non_production
  production
}

enum OutcomeRecordStatus {
  staged
  needs_review
  approved
  superseded
  rejected
}

enum OutcomeEventKind {
  trade
  national_draft
  preseason_draft
  rookie_draft
  midseason_draft
  supplemental_selection
  other_acquisition
}

enum OutcomeAssetKind {
  player
  current_pick
  future_pick
  cash
  list_right
  other
}

enum OutcomeObservationGrain {
  match
  season
  career
}

enum OutcomeAcquisitionMechanism {
  national_draft
  rookie_draft
  midseason_draft
  preseason_draft
  mini_draft
  trade
  free_agency
  pre_draft
  post_draft
  training_squad
}

enum OutcomeMetricAvailability {
  exact
  missing
  partial
  quarantined
}

enum OutcomeFactualAvailability {
  measured
  missing
  not_applicable
  quarantined
}

enum OutcomeMatchCompletionState {
  completed
  scheduled
  abandoned
  cancelled
  unknown
}

enum OutcomeFactualReconciliationState {
  measured
  unresolved
  conflicting
  quarantined
  not_applicable
  unavailable
}

enum OutcomeAchievementReconciliationState {
  affirmed
  conflicting
  quarantined
  not_applicable
  unavailable
}

model OutcomeRegistryHead {
  singletonId  Int      @id @default(1) @map("singleton_id")
  revision     Int
  lastEventId  String?  @map("last_event_id")
  registryJson Json     @map("registry_json")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @outcomes.Timestamptz(3)

  @@map("outcome_registry_head")
}

model OutcomeReleaseManifest {
  releaseId                           String                                      @id @map("release_id")
  scopeKey                            String                                      @map("scope_key")
  environment                         String
  createdAt                           DateTime                                    @map("created_at") @outcomes.Timestamptz(3)
  effectiveThrough                    DateTime                                    @map("effective_through") @outcomes.Timestamptz(3)
  manifestJson                        Json                                        @map("manifest_json")
  manifestCanonicalJson               String?                                     @map("manifest_canonical_json") @outcomes.Text
  projections                         OutcomeProjectionManifest[]
  registryEvents                      OutcomeRegistryEvent[]
  stateCommitments                    OutcomeRecordStateCommitment[]
  sourceCaptureMembers                OutcomeReleaseSourceCapture[]
  eventVersionMembers                 OutcomeReleaseEventVersion[]
  eventAssetMembers                   OutcomeReleaseEventAsset[]
  draftSelectionMembers               OutcomeReleaseDraftSelection[]
  pickCustodyMembers                  OutcomeReleasePickCustody[]
  pickRealizationMembers              OutcomeReleasePickRealization[]
  observationMembers                  OutcomeReleaseStatObservation[]
  identityMembers                     OutcomeReleaseIdentityAssignment[]
  lineageMembers                      OutcomeReleasePickLineage[]
  spellMembers                        OutcomeReleaseAcquisitionSpell[]
  reconciliationMembers               OutcomeReleaseReconciliation[]
  reviewMembers                       OutcomeReleaseReviewDecision[]
  activePointer                       OutcomeActiveRelease?
  promotionFactualLineage             OutcomeCorpusFactualLineage?
  valuationDatasetFactualLineage      OutcomeValuationDatasetFactualLineage?
  publicFactualArchive                OutcomePublicFactualArchive?
  valuationDatasets                   OutcomeValuationDatasetCandidate[]
  valuationDatasetAuthorities         OutcomeValuationDatasetOperationAuthority[]
  pickPavObservationSets              OutcomePickPavObservationSet[]
  sourceQualificationReports          OutcomeValuationSourceQualificationReport[]
  preparedValuationInputSets          OutcomePreparedValuationInputSet[]
  privateValuationEvaluationDecisions OutcomePrivateValuationEvaluationDecision[]
  privateValuationEvaluationHeads     OutcomePrivateValuationEvaluationHead[]
  currentValuationCohortOperations    OutcomeCurrentValuationCohortOperation[]
  privateValuationFactualOutput       OutcomePrivateValuationFactualOutput?

  @@index([scopeKey, createdAt])
  @@map("outcome_release_manifest")
}

model OutcomeProjectionManifest {
  projectionId    String                           @id @map("projection_id")
  releaseId       String                           @map("release_id")
  publicArchiveId String?                          @unique @map("public_archive_id")
  createdAt       DateTime                         @map("created_at") @outcomes.Timestamptz(3)
  manifestJson    Json                             @map("manifest_json")
  release         OutcomeReleaseManifest           @relation(fields: [releaseId], references: [releaseId], onDelete: Restrict)
  publicArchive   OutcomePublicFactualArchive?     @relation(fields: [publicArchiveId], references: [archiveId], onDelete: Restrict)
  projectionItems OutcomeProjectionItem[]
  factualItemSet  OutcomeFactualProjectionItemSet?

  @@unique([releaseId, projectionId], map: "outcome_projection_manifest_release_projection_key")
  @@map("outcome_projection_manifest")
}

model OutcomeRegistryEvent {
  revision        Int                            @id
  eventId         String                         @unique @map("event_id")
  previousEventId String?                        @unique @map("previous_event_id")
  releaseId       String                         @map("release_id")
  scopeKey        String                         @map("scope_key")
  action          String
  occurredAt      DateTime                       @map("occurred_at") @outcomes.Timestamptz(3)
  eventJson       Json                           @map("event_json")
  release         OutcomeReleaseManifest         @relation(fields: [releaseId], references: [releaseId], onDelete: Restrict)
  previousEvent   OutcomeRegistryEvent?          @relation("OutcomeRegistryEventChain", fields: [previousEventId], references: [eventId], onDelete: Restrict)
  nextEvent       OutcomeRegistryEvent?          @relation("OutcomeRegistryEventChain")
  affectedStates  OutcomeRecordStateCommitment[]

  @@index([scopeKey, revision])
  @@index([releaseId, revision])
  @@map("outcome_registry_event")
}

model OutcomeRecordStateCommitment {
  eventRevision Int                    @map("event_revision")
  releaseId     String                 @map("release_id")
  recordStateId String                 @unique @map("record_state_id")
  recordState   Json                   @map("record_state_json")
  event         OutcomeRegistryEvent   @relation(fields: [eventRevision], references: [revision], onDelete: Restrict)
  release       OutcomeReleaseManifest @relation(fields: [releaseId], references: [releaseId], onDelete: Restrict)

  @@id([eventRevision, releaseId])
  @@index([releaseId, eventRevision], map: "outcome_record_state_commitment_release_revision_idx")
  @@map("outcome_record_state_commitment")
}

model OutcomeActiveRelease {
  scopeKey    String                 @id @map("scope_key")
  releaseId   String                 @unique @map("release_id")
  activatedAt DateTime               @map("activated_at") @outcomes.Timestamptz(3)
  revision    Int
  release     OutcomeReleaseManifest @relation(fields: [releaseId], references: [releaseId], onDelete: Restrict)

  @@map("outcome_active_release")
}

model OutcomeProjectionItem {
  releaseId         String                    @map("release_id")
  projectionId      String                    @map("projection_id")
  ordinal           BigInt
  itemKey           String                    @map("item_key")
  eventId           String                    @map("event_id")
  tradeId           String?                   @map("trade_id")
  assetId           String?                   @map("asset_id")
  year              Int
  aflClubId         String                    @map("afl_club_id")
  clubName          String                    @map("club_name")
  playerName        String                    @map("player_name")
  searchText        String                    @map("search_text")
  metricCodes       String[]                  @default([]) @map("metric_codes")
  statusCodes       String[]                  @default([]) @map("status_codes")
  itemJson          Json                      @map("item_json")
  itemCanonicalJson String?                   @map("item_canonical_json") @outcomes.Text
  itemSha256        String?                   @map("item_sha256") @outcomes.Char(64)
  projection        OutcomeProjectionManifest @relation(fields: [releaseId, projectionId], references: [releaseId, projectionId], onDelete: Restrict, map: "outcome_projection_item_projection_fkey")

  @@id([projectionId, ordinal])
  @@unique([projectionId, itemKey], map: "outcome_projection_item_projection_item_key")
  @@index([releaseId, year, ordinal], map: "outcome_projection_item_release_year_ordinal_idx")
  @@index([releaseId, aflClubId, ordinal], map: "outcome_projection_item_release_club_ordinal_idx")
  @@index([releaseId, playerName, ordinal], map: "outcome_projection_item_release_player_ordinal_idx")
  @@index([metricCodes], type: Gin, map: "outcome_projection_item_metric_codes_gin_idx")
  @@index([statusCodes], type: Gin, map: "outcome_projection_item_status_codes_gin_idx")
  @@map("outcome_projection_item")
}

model OutcomeFactualProjectionItemSet {
  projectionId  String                    @id @map("projection_id")
  releaseId     String                    @map("release_id")
  itemCount     Int                       @map("item_count")
  itemSetSha256 String                    @map("item_set_sha256") @outcomes.Char(64)
  finalizedAt   DateTime                  @map("finalized_at") @outcomes.Timestamptz(3)
  projection    OutcomeProjectionManifest @relation(fields: [releaseId, projectionId], references: [releaseId, projectionId], onDelete: Restrict, map: "outcome_factual_projection_item_set_projection_fkey")

  @@unique([releaseId, projectionId], map: "outcome_factual_projection_item_set_release_projection_key")
  @@map("outcome_factual_projection_item_set")
}

model OutcomeArtifactCustody {
  artifactId                                   String                                               @id @map("artifact_id")
  contentSha256                                String                                               @map("content_sha256") @outcomes.Char(64)
  storageUri                                   String                                               @unique @map("storage_uri")
  mediaType                                    String                                               @map("media_type")
  byteLength                                   BigInt                                               @map("byte_length")
  artifactClass                                OutcomeArtifactClass                                 @map("artifact_class")
  environment                                  OutcomeEnvironment
  custodyProfileId                             String?                                              @map("custody_profile_id")
  createdAt                                    DateTime                                             @map("created_at") @outcomes.Timestamptz(3)
  verifiedAt                                   DateTime                                             @map("verified_at") @outcomes.Timestamptz(3)
  custodyJson                                  Json                                                 @map("custody_json")
  sourceCaptures                               OutcomeSourceCapture[]
  captureAttemptEvidence                       OutcomeSourceCaptureAttempt[]
  governedEvidence                             OutcomeGovernedEvidenceReference[]
  valuationProjections                         OutcomeValuationProjectionManifest[]
  valuationDatasetArtifacts                    OutcomeValuationDatasetArtifactMember[]
  hpnPavMethods                                OutcomeHpnPavMethod[]
  workbookTransactionReviewSets                OutcomeWorkbookTransactionReviewSet[]
  privateEvaluationAuthoritySnapshots          OutcomePrivateEvaluationAuthoritySnapshot[]          @relation("PrivateEvaluationAuthoritySnapshotArtifact")
  privateEvaluationMaterializationManifests    OutcomePrivateEvaluationMaterializationManifest[]    @relation("PrivateEvaluationMaterializationManifestArtifact")
  privateEvaluationInspectionReceipts          OutcomePrivateEvaluationInspectionReceipt[]          @relation("PrivateEvaluationInspectionReceiptArtifact")
  privateEvaluationTransitionIntents           OutcomePrivateEvaluationTransitionIntent[]           @relation("PrivateEvaluationTransitionIntentArtifact")
  privateEvaluationGenerationArtifacts         OutcomeLocalPrivateTradeEvaluationGeneration[]       @relation("PrivateEvaluationGenerationArtifact")
  privateEvaluationNarrativeArtifacts          OutcomeLocalPrivateTradeEvaluationGeneration[]       @relation("PrivateEvaluationNarrativeArtifact")
  privateEvaluationProjectionManifestArtifacts OutcomeLocalPrivateTradeEvaluationGeneration[]       @relation("PrivateEvaluationProjectionManifestArtifact")
  privateEvaluationTransitionReceipts          OutcomePrivateEvaluationTransitionReceipt[]          @relation("PrivateEvaluationTransitionReceiptArtifact")
  privateEvaluationReconstructionVerifications OutcomePrivateEvaluationReconstructionVerification[] @relation("PrivateEvaluationReconstructionVerificationArtifact")
  governedComponentRunManifests                OutcomeGovernedValuationComponentRun[]               @relation("GovernedValuationComponentRunManifestArtifact")
  governedComponentRunNativeExecutions         OutcomeGovernedValuationComponentRun[]               @relation("GovernedValuationComponentRunNativeArtifact")
  governedComponentRunProtocols                OutcomeGovernedValuationComponentRun[]               @relation("GovernedValuationComponentRunProtocolArtifact")
  governedComponentRunDatasets                 OutcomeGovernedValuationComponentRun[]               @relation("GovernedValuationComponentRunDatasetArtifact")
  governedComponentRunAdmissions               OutcomeGovernedValuationComponentRun[]               @relation("GovernedValuationComponentRunAdmissionArtifact")
  governedComponentValidationNativeExecutions  OutcomeGovernedComponentValidationEvidence[]         @relation("GovernedComponentValidationNativeArtifact")
  governedComponentValidationReports           OutcomeGovernedComponentValidationEvidence[]         @relation("GovernedComponentValidationReportArtifact")
  governedPickExecutionArtifacts               OutcomeGovernedPickPavModelExecution[]               @relation("GovernedPickExecutionArtifact")
  governedPickDatasetArtifacts                 OutcomeGovernedPickPavModelExecution[]               @relation("GovernedPickDatasetArtifact")
  governedPickAdmissionArtifacts               OutcomeGovernedPickPavModelExecution[]               @relation("GovernedPickAdmissionArtifact")
  governedPickProtocolArtifacts                OutcomeGovernedPickPavModelExecution[]               @relation("GovernedPickProtocolArtifact")

  @@unique([artifactClass, contentSha256], map: "outcome_artifact_class_sha256_key")
  @@index([environment, artifactClass, createdAt], map: "outcome_artifact_environment_class_created_idx")
  @@map("outcome_artifact_custody")
}

model OutcomeGovernedEvidenceReference {
  referenceId              String                                            @id @map("reference_id")
  referenceSha256          String                                            @unique @map("reference_sha256") @outcomes.Char(64)
  evidenceKind             String                                            @map("evidence_kind")
  artifactId               String                                            @map("artifact_id")
  environment              OutcomeEnvironment
  status                   OutcomeRecordStatus
  approvalDecisionId       String                                            @map("approval_decision_id")
  createdAt                DateTime                                          @map("created_at") @outcomes.Timestamptz(3)
  evidenceCanonicalJson    String                                            @map("evidence_canonical_json")
  evidenceJson             Json                                              @map("evidence_json")
  artifact                 OutcomeArtifactCustody                            @relation(fields: [artifactId], references: [artifactId], onDelete: Restrict)
  approvalDecision         OutcomeReviewDecision                             @relation(fields: [approvalDecisionId], references: [decisionId], onDelete: Restrict)
  reviewerAuthority        OutcomeOperationalPrincipalAuthority?
  externalIdentityReviews  OutcomeExternalIdentityReviewDecision[]
  externalPromotionReviews OutcomeExternalCanonicalPromotionReviewDecision[]

  @@index([evidenceKind, environment, status], map: "outcome_governed_evidence_kind_status_idx")
  @@map("outcome_governed_evidence_reference")
}

model OutcomeOperationalPrincipalAuthority {
  authorityEvidenceId               String                                             @id @map("authority_evidence_id")
  principalRef                      String                                             @map("principal_ref")
  role                              String
  scopeKey                          String                                             @map("scope_key")
  provider                          String
  capabilityId                      String                                             @map("capability_id")
  competition                       String
  validFromSeason                   Int                                                @map("valid_from_season")
  validThroughSeason                Int                                                @map("valid_through_season")
  validFrom                         DateTime                                           @map("valid_from") @outcomes.Timestamptz(3)
  validThrough                      DateTime?                                          @map("valid_through") @outcomes.Timestamptz(3)
  evidence                          OutcomeGovernedEvidenceReference                   @relation(fields: [authorityEvidenceId], references: [referenceId], onDelete: Restrict)
  modelRunOperationalAuthorizations OutcomeValuationModelRunOperationalAuthorization[]

  @@index([principalRef, role, scopeKey, provider, capabilityId, competition, validFromSeason, validThroughSeason], map: "outcome_operational_authority_principal_scope_idx")
  @@map("outcome_operational_principal_authority")
}

model OutcomeSourceCaptureAttempt {
  attemptId          String                  @id @map("attempt_id")
  environment        OutcomeEnvironment
  provider           String
  dataset            String
  capabilityId       String?                 @map("capability_id")
  evidenceArtifactId String?                 @map("evidence_artifact_id")
  status             String
  startedAt          DateTime                @map("started_at") @outcomes.Timestamptz(3)
  completedAt        DateTime?               @map("completed_at") @outcomes.Timestamptz(3)
  attemptJson        Json                    @map("attempt_json")
  evidenceArtifact   OutcomeArtifactCustody? @relation(fields: [evidenceArtifactId], references: [artifactId], onDelete: Restrict)
  sourceCapture      OutcomeSourceCapture?

  @@index([provider, dataset, startedAt], map: "outcome_capture_attempt_provider_started_idx")
  @@map("outcome_source_capture_attempt")
}

model OutcomeSourceCapture {
  captureId                   String                                             @id @map("capture_id")
  attemptId                   String                                             @unique @map("attempt_id")
  sourceSnapshotId            String                                             @unique @map("source_snapshot_id")
  sourceArtifactId            String                                             @map("source_artifact_id")
  environment                 OutcomeEnvironment
  provider                    String
  dataset                     String
  datasetVersion              String                                             @map("dataset_version")
  accessMechanism             String                                             @map("access_mechanism")
  capabilityId                String?                                            @map("capability_id")
  competition                 String
  anchorSeasonYear            Int                                                @map("anchor_season_year")
  effectiveAt                 DateTime                                           @map("effective_at") @outcomes.Timestamptz(3)
  capturedAt                  DateTime                                           @map("captured_at") @outcomes.Timestamptz(3)
  status                      OutcomeRecordStatus
  manifestJson                Json                                               @map("manifest_json")
  sourceArtifact              OutcomeArtifactCustody                             @relation(fields: [sourceArtifactId], references: [artifactId], onDelete: Restrict)
  attempt                     OutcomeSourceCaptureAttempt                        @relation(fields: [attemptId], references: [attemptId], onDelete: Restrict)
  anchorSeason                OutcomeCompetitionSeason                           @relation("OutcomeCaptureAnchorSeason", fields: [competition, anchorSeasonYear], references: [competition, seasonYear], onDelete: Restrict)
  scopeSeasons                OutcomeSourceCaptureSeason[]
  importRuns                  OutcomeImportRun[]
  normalizationRuns           OutcomeProviderNormalizationRun[]
  normalizationAttempts       OutcomeProviderNormalizationAttempt[]
  externalEvidenceBatch       OutcomeExternalEvidenceBatch?
  historicalCompletionResults OutcomeExternalHistoricalCaptureCompletionResult[]
  identities                  OutcomePlayerIdentity[]
  observations                OutcomePlayerStatObservation[]
  exceptions                  OutcomeDataException[]
  releaseMembers              OutcomeReleaseSourceCapture[]
  canonicalPromotionRuns      OutcomeExternalCanonicalPromotionImportRun[]
  valuationDatasetAdmissions  OutcomeValuationDatasetAdmissionSource[]
  valuationDatasetFieldSets   OutcomeValuationDatasetConsumedFieldSet[]
  privateValuationCaptureBindings OutcomePrivateValuationCaptureBinding[] @relation("PrivateValuationCaptureSource")
  privateValuationSourceAdmission OutcomePrivateValuationSourceAdmission?
  privateValuationHpnSourceAdmission OutcomePrivateValuationHpnSourceAdmission?

  @@unique([captureId, attemptId, sourceSnapshotId], map: "outcome_source_capture_exact_ancestry_key")
  @@index([provider, dataset, capturedAt], map: "outcome_source_capture_provider_captured_idx")
  @@index([sourceArtifactId], map: "outcome_source_capture_artifact_idx")
  @@map("outcome_source_capture")
}

model OutcomeExternalEvidenceBatch {
  batchId                    String                                            @id @map("batch_id")
  captureId                  String                                            @unique @map("capture_id")
  provider                   String
  evidenceCount              Int                                               @map("evidence_count")
  issueCount                 Int                                               @map("issue_count")
  rowSetSha256               String                                            @map("row_set_sha256") @outcomes.Char(64)
  issueSetSha256             String                                            @map("issue_set_sha256") @outcomes.Char(64)
  status                     String
  finalizedAt                DateTime?                                         @map("finalized_at") @outcomes.Timestamptz(3)
  batchJson                  Json                                              @map("batch_json")
  capture                    OutcomeSourceCapture                              @relation(fields: [captureId], references: [captureId], onDelete: Restrict)
  evidenceRows               OutcomeExternalEvidenceRow[]
  issues                     OutcomeExternalEvidenceIssue[]
  reconciliationMembers      OutcomeExternalReconciliationSourceBatch[]
  historicalCompletionResult OutcomeExternalHistoricalCaptureCompletionResult?

  @@index([provider, status, finalizedAt], map: "outcome_external_evidence_batch_provider_status_idx")
  @@map("outcome_external_evidence_batch")
}

model OutcomeExternalIdentitySubject {
  subjectId            String                                  @id @map("subject_id")
  environment          OutcomeEnvironment
  competition          String
  provider             String
  entityKind           String                                  @map("entity_kind")
  scopeKind            String                                  @map("scope_kind")
  nativeId             String?                                 @map("native_id")
  recordedName         String?                                 @map("recorded_name")
  seasonYear           Int?                                    @map("season_year")
  subjectSha256        String                                  @map("subject_sha256") @outcomes.Char(64)
  subjectCanonicalJson String                                  @map("subject_canonical_json") @outcomes.Text
  subjectJson          Json                                    @map("subject_json")
  createdAt            DateTime                                @map("created_at") @outcomes.Timestamptz(3)
  decisions            OutcomeExternalIdentityReviewDecision[]
  head                 OutcomeExternalIdentityResolutionHead?

  @@index([provider, entityKind, nativeId], map: "outcome_external_identity_native_lookup_idx")
  @@index([provider, entityKind, recordedName, seasonYear], map: "outcome_external_identity_name_lookup_idx")
  @@map("outcome_external_identity_subject")
}

model OutcomeExternalIdentityReviewDecision {
  decisionId                   String                                     @id @map("decision_id")
  subjectId                    String                                     @map("subject_id")
  historicalCompletionId       String                                     @map("historical_completion_id")
  reviewPackageId              String                                     @map("review_package_id")
  workItemId                   String                                     @map("work_item_id")
  workItemSha256               String                                     @map("work_item_sha256") @outcomes.Char(64)
  workItemCanonicalJson        String                                     @map("work_item_canonical_json") @outcomes.Text
  revision                     Int
  outcome                      String
  canonicalTargetKind          String?                                    @map("canonical_target_kind")
  canonicalTargetId            String?                                    @map("canonical_target_id")
  canonicalTargetSnapshot      String?                                    @map("canonical_target_snapshot_sha256") @outcomes.Char(64)
  canonicalTargetCanonicalJson String?                                    @map("canonical_target_canonical_json") @outcomes.Text
  authorityEvidenceId          String                                     @map("authority_evidence_id")
  supersedesDecisionId         String?                                    @unique @map("supersedes_decision_id")
  decisionSha256               String                                     @map("decision_sha256") @outcomes.Char(64)
  decisionCanonicalJson        String                                     @map("decision_canonical_json") @outcomes.Text
  decisionJson                 Json                                       @map("decision_json")
  decidedAt                    DateTime                                   @map("decided_at") @outcomes.Timestamptz(3)
  subject                      OutcomeExternalIdentitySubject             @relation(fields: [subjectId], references: [subjectId], onDelete: Restrict)
  historicalCompletion         OutcomeExternalHistoricalCaptureCompletion @relation(fields: [historicalCompletionId], references: [completionId], onDelete: Restrict)
  reviewDecision               OutcomeReviewDecision                      @relation(fields: [decisionId], references: [decisionId], onDelete: Restrict)
  authorityEvidence            OutcomeGovernedEvidenceReference           @relation(fields: [authorityEvidenceId], references: [referenceId], onDelete: Restrict)
  supersedes                   OutcomeExternalIdentityReviewDecision?     @relation("OutcomeExternalIdentityReviewChain", fields: [supersedesDecisionId], references: [decisionId], onDelete: Restrict)
  supersededBy                 OutcomeExternalIdentityReviewDecision?     @relation("OutcomeExternalIdentityReviewChain")
  currentHead                  OutcomeExternalIdentityResolutionHead?

  @@unique([subjectId, revision], map: "outcome_external_identity_review_subject_revision_key")
  @@index([historicalCompletionId, subjectId], map: "outcome_external_identity_review_completion_idx")
  @@index([authorityEvidenceId, decidedAt], map: "outcome_external_identity_review_authority_idx")
  @@map("outcome_external_identity_review_decision")
}

model OutcomeExternalIdentityResolutionHead {
  subjectId  String                                @id @map("subject_id")
  revision   Int
  decisionId String                                @unique @map("decision_id")
  status     String
  updatedAt  DateTime                              @map("updated_at") @outcomes.Timestamptz(3)
  subject    OutcomeExternalIdentitySubject        @relation(fields: [subjectId], references: [subjectId], onDelete: Restrict)
  decision   OutcomeExternalIdentityReviewDecision @relation(fields: [decisionId], references: [decisionId], onDelete: Restrict)

  @@index([status, updatedAt], map: "outcome_external_identity_head_status_idx")
  @@map("outcome_external_identity_resolution_head")
}

model OutcomeExternalReconciliationCandidate {
  candidateId                  String                                            @id @map("candidate_id")
  sourceAuthorityKind          String?                                           @map("source_authority_kind") @outcomes.Text
  historicalCompletionId       String?                                           @map("historical_completion_id") @outcomes.Text
  environment                  OutcomeEnvironment
  competition                  String
  anchorSeasonYear             Int                                               @map("anchor_season_year")
  reconciledAt                 DateTime                                          @map("reconciled_at") @outcomes.Timestamptz(3)
  sourceBatchCount             Int                                               @map("source_batch_count")
  identityResolutionCount      Int                                               @map("identity_resolution_count")
  transactionCount             Int                                               @map("transaction_count")
  transferCount                Int                                               @map("transfer_count")
  draftSelectionCount          Int                                               @map("draft_selection_count")
  pickCustodyCount             Int                                               @map("pick_custody_count")
  pickLineageCount             Int                                               @map("pick_lineage_count")
  issueCount                   Int                                               @map("issue_count")
  status                       String
  finalizedAt                  DateTime?                                         @map("finalized_at") @outcomes.Timestamptz(3)
  sourceAuthorityJson          Json?                                             @map("source_authority_json")
  candidateCanonicalJson       String?                                           @map("candidate_canonical_json") @outcomes.Text
  candidateJson                Json                                              @map("candidate_json")
  historicalCompletion         OutcomeExternalHistoricalCaptureCompletion?       @relation(fields: [historicalCompletionId], references: [completionId], onDelete: Restrict)
  sourceBatches                OutcomeExternalReconciliationSourceBatch[]
  identityResolutions          OutcomeExternalReconciliationIdentityResolution[]
  transactions                 OutcomeExternalReconciliationTransaction[]
  transfers                    OutcomeExternalReconciliationTransfer[]
  draftSelections              OutcomeExternalReconciliationDraftSelection[]
  pickCustody                  OutcomeExternalReconciliationPickCustody[]
  pickLineage                  OutcomeExternalReconciliationPickLineage[]
  issues                       OutcomeExternalReconciliationIssue[]
  canonicalPromotion           OutcomeExternalCanonicalPromotion?
  canonicalPromotionReviews    OutcomeExternalCanonicalPromotionReviewDecision[]
  canonicalPromotionReviewHead OutcomeExternalCanonicalPromotionReviewHead?

  @@index([status, finalizedAt], map: "outcome_external_reconciliation_status_idx")
  @@index([historicalCompletionId, reconciledAt], map: "outcome_external_reconciliation_completion_idx")
  @@map("outcome_external_reconciliation_candidate")
}

model OutcomeExternalReconciliationSourceBatch {
  candidateId String                                 @map("candidate_id")
  ordinal     Int
  batchId     String                                 @map("batch_id")
