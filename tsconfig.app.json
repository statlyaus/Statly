{
  "extends": "./tsconfig.next.json",
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "middleware.ts",
    "shared/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "src/types"
  ],
  "exclude": [
    "node_modules",
    "Scripts/**/*",
    "functions",
    "functions/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/components/rankings/__tests__/**"
  ]
}
