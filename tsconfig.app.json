{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "Scripts/**/*",
    "functions",
    "functions/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/components/rankings/__tests__/**"
  ]
}


