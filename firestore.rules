rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function leagueMemberPath(leagueId, userId) {
      return /databases/$(database)/documents/leagues/$(leagueId)/members/$(userId);
    }

    function leagueMemberDoc(leagueId) {
      return get(leagueMemberPath(leagueId, request.auth.uid));
    }

    function isLeagueMember(leagueId) {
      return isAuthenticated()
        && exists(leagueMemberPath(leagueId, request.auth.uid))
        && leagueMemberDoc(leagueId).data.isActive != false
        && leagueMemberDoc(leagueId).data.status != 'REMOVED'
        && leagueMemberDoc(leagueId).data.status != 'removed'
        && leagueMemberDoc(leagueId).data.status != 'INACTIVE'
        && leagueMemberDoc(leagueId).data.status != 'inactive'
        && leagueMemberDoc(leagueId).data.status != 'DECLINED'
        && leagueMemberDoc(leagueId).data.status != 'declined';
    }

    function isLeagueManager(leagueId) {
      return isLeagueMember(leagueId)
        && (
          leagueMemberDoc(leagueId).data.role in [
            'owner',
            'admin',
            'manager',
            'commissioner',
            'OWNER',
            'ADMIN',
            'MANAGER',
            'COMMISSIONER'
          ]
        );
    }

    function isResourceUser(resource) {
      return request.auth.uid == resource.data.userId;
    }

    function isSelfMemberPreferenceUpdate(userId) {
      return request.auth.uid == userId
        && request.resource.data.leagueId == resource.data.leagueId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'draftPreferences',
          'scoringPreferences',
          'notificationSettings'
        ]);
    }

    function isRosterLineupUpdate(leagueId) {
      return request.resource.data.leagueId == resource.data.leagueId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'teamName',
          'captain',
          'viceCaptain',
          'bench',
          'emergencies',
          'updatedAt'
        ]);
    }

    function hasLeagueId(leagueId) {
      return request.resource.data.leagueId == leagueId;
    }

    match /players/{playerId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /leagueMembers/{memberId} {
      allow read: if isAuthenticated()
        && resource.data.isActive != false
        && isLeagueMember(resource.data.leagueId);
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    match /leagues/{leagueId} {
      allow read: if isLeagueMember(leagueId);
      allow write: if false;

      match /members/{userId} {
        allow read: if isLeagueMember(leagueId);
        allow create: if false;
        allow update: if isSelfMemberPreferenceUpdate(userId);
        allow delete: if false;
      }

      match /rosters/{teamId} {
        allow read: if isLeagueMember(leagueId);
        allow create: if false;
        allow update: if isLeagueMember(leagueId)
          && (isResourceUser(resource) || isLeagueManager(leagueId))
          && isRosterLineupUpdate(leagueId);
        allow delete: if false;
      }

      match /draft/{draftDoc} {
        allow read: if isLeagueMember(leagueId);
        allow write: if false;

        match /picks/{pickId} {
          allow read: if isLeagueMember(leagueId);
          allow write: if false;
        }

        match /active/{pickId} {
          allow read: if isLeagueMember(leagueId);
          allow write: if false;
        }
      }

      match /drafts/{draftId} {
        allow read: if isLeagueMember(leagueId);
        allow write: if false;

        match /picks/{pickId} {
          allow read: if isLeagueMember(leagueId);
          allow write: if false;
        }
      }

      match /availablePlayers/{playerId} {
        allow read: if isLeagueMember(leagueId);
        allow write: if false;
      }

      match /playerOwnerships/{playerId} {
        allow read: if isLeagueMember(leagueId);
        allow write: if false;
      }

      match /trades/{tradeId} {
        allow read: if isLeagueMember(leagueId);
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }

      match /waivers/{claimId} {
        allow read: if isLeagueMember(leagueId);
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }

      match /waiverPriorities/{userId} {
        allow read: if isLeagueMember(leagueId)
          && (request.auth.uid == userId || isLeagueManager(leagueId));
        allow write: if false;
      }

      match /activity/{activityId} {
        allow read: if isLeagueMember(leagueId);
        allow write: if false;
      }

      match /teamActions/{actionId} {
        allow read: if isLeagueMember(leagueId);
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }

      match /watchlists/{userId} {
        allow read, write: if false;
      }

      match /config/{configDoc} {
        allow read: if isLeagueMember(leagueId);
        allow write: if false;
      }

      match /messages/{messageId} {
        allow read: if isLeagueMember(leagueId);
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }

      match /standings/{standingDoc} {
        allow read: if isLeagueMember(leagueId);
        allow write: if false;
      }
    }

    match /activeDrafts/{leagueId} {
      allow read: if isLeagueMember(leagueId);
      allow write: if false;
    }

    match /admin/{document=**} {
      allow read, write: if false;
    }

    match /logs/{logId} {
      allow read, write: if false;
    }

    match /analytics/{analyticsDoc} {
      allow read, write: if false;
    }

    match /analytics_web_vitals/{metricId} {
      allow read, write: if false;
    }
  }
}
