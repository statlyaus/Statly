rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isLeagueMember(leagueId) {
      return exists(/databases/$(database)/documents/leagues/$(leagueId)/members/$(request.auth.uid));
    }
    
    function isCommissioner(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId)/members/$(request.auth.uid)).data.role == 'COMMISSIONER';
    }
    
    function isOwner(resource) {
      return request.auth.uid == resource.data.userId;
    }
    
    // Global player data (read-only for users)
    match /players/{playerId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin only via Functions
    }
    
    // Global match data (read-only for users)
    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin only via Functions
    }
    
    // User profiles
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // League-scoped data
    match /leagues/{leagueId} {
      // League document itself
      allow read: if isAuthenticated() && isLeagueMember(leagueId);
      allow write: if isAuthenticated() && isCommissioner(leagueId);
      
      // League members
      match /members/{userId} {
        allow read: if isAuthenticated() && isLeagueMember(leagueId);
        allow write: if isAuthenticated() && 
          (request.auth.uid == userId || isCommissioner(leagueId));
      }
      
      // Team rosters
      match /rosters/{teamId} {
        allow read: if isAuthenticated() && isLeagueMember(leagueId);
        allow create: if isAuthenticated() && isLeagueMember(leagueId) &&
          request.auth.uid == request.resource.data.userId;
        allow update, delete: if isAuthenticated() && 
          (isOwner(resource) || isCommissioner(leagueId));
      }
      
      // Draft system
      match /draft/{draftDoc} {
        allow read: if isAuthenticated() && isLeagueMember(leagueId);
        allow write: if isAuthenticated() && 
          (isCommissioner(leagueId) || isOwner(resource));
          
        // Draft picks subcollection
        match /picks/{pickId} {
          allow read: if isAuthenticated() && isLeagueMember(leagueId);
          allow create: if isAuthenticated() && isLeagueMember(leagueId);
          allow update: if isAuthenticated() && 
            (isOwner(resource) || isCommissioner(leagueId));
        }
        
        // Active picks subcollection (real-time draft state)
        match /active/{pickId} {
          allow read: if isAuthenticated() && isLeagueMember(leagueId);
          allow write: if isAuthenticated() && 
            (isOwner(resource) || isCommissioner(leagueId));
        }
      }
      
      // Trade system
      match /trades/{tradeId} {
        allow read: if isAuthenticated() && isLeagueMember(leagueId);
        allow create: if isAuthenticated() && isLeagueMember(leagueId) &&
          request.auth.uid == request.resource.data.fromUserId;
        allow update: if isAuthenticated() && (
          request.auth.uid == resource.data.toUserId ||
          request.auth.uid == resource.data.fromUserId ||
          isCommissioner(leagueId)
        );
        allow delete: if isAuthenticated() && 
          (isOwner(resource) || isCommissioner(leagueId));
      }
      
      // Waiver system
      match /waivers/{claimId} {
        allow read: if isAuthenticated() && isLeagueMember(leagueId);
        allow create: if isAuthenticated() && isLeagueMember(leagueId) &&
          request.auth.uid == request.resource.data.userId;
        allow update: if isAuthenticated() && 
          (isOwner(resource) || isCommissioner(leagueId));
        allow delete: if isAuthenticated() && 
          (isOwner(resource) || isCommissioner(leagueId));
      }
      
      // Personal watchlists
      match /watchlists/{userId} {
        allow read, write: if isAuthenticated() && 
          (request.auth.uid == userId || isCommissioner(leagueId));
      }
      
      // League configuration
      match /config/{configDoc} {
        allow read: if isAuthenticated() && isLeagueMember(leagueId);
        allow write: if isAuthenticated() && isCommissioner(leagueId);
      }
      
      // League messages/chat
      match /messages/{messageId} {
        allow read: if isAuthenticated() && isLeagueMember(leagueId);
        allow create: if isAuthenticated() && isLeagueMember(leagueId) &&
          request.auth.uid == request.resource.data.userId;
        allow update, delete: if isAuthenticated() && 
          (isOwner(resource) || isCommissioner(leagueId));
      }
      
      // League standings (computed)
      match /standings/{standingDoc} {
        allow read: if isAuthenticated() && isLeagueMember(leagueId);
        allow write: if false; // Functions only
      }
    }
    
    // Admin-only collections
    match /admin/{document=**} {
      allow read, write: if false; // Functions only
    }
    
    // System logs (Functions only)
    match /logs/{logId} {
      allow read, write: if false; // Functions only
    }
    
    // Analytics data (Functions only)
    match /analytics/{analyticsDoc} {
      allow read, write: if false; // Functions only
    }
  }
}
