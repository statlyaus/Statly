{
  "name": "my-fantasy-afl-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "socket": "tsx socketio-server.ts",
    "dev:full": "concurrently \"npm run dev\" \"npm run socket\"",
    "dev:with-worker": "concurrently \"npm run dev\" \"npm run worker:dev\"",
    "dev:full:all": "concurrently \"npm run dev\" \"npm run socket\" \"npm run worker:dev\"",
    "worker:dev": "tsx --watch src/api/workers/webVitalsWorker.ts",
    "worker:build": "tsc -p tsconfig.worker.json",
    "worker:start": "node dist/api/workers/webVitalsWorker.js",
    "clean": "rimraf .next dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "update:check": "npx npm-check-updates",
    "update:interactive": "npx npm-check-updates -u",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "init-firebase-db": "tsx Scripts/initialize-firebase-db.ts",
    "check:etl": "tsx Scripts/check-etl-setup.ts",
    "db:check": "tsx Scripts/check-database.ts",
    "firestore:smoke": "tsx Scripts/firestore-smoke.ts"
  },
