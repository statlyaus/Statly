{
  "name": "my-fantasy-afl-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "auth-worker:build": "node Scripts/build-auth-service-worker.mjs",
    "predev": "npm run auth-worker:build",
    "dev": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && next dev --turbopack'",
    "prebuild": "cross-env NODE_ENV=production npm run auth-worker:build",
    "build": "npm run prisma:generate && next build",
    "prebuild:production": "cross-env NODE_ENV=production npm run auth-worker:build",
    "build:production": "npm run prisma:generate && next build",
    "start": "next start",
    "socket": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && NODE_ENV=development tsx -r dotenv/config ./src/server/socketioServer.ts'",
    "dev:full": "concurrently \"npm run dev\" \"npm run socket\"",
    "dev:with-worker": "concurrently \"npm run dev\" \"npm run draft-worker:dev\"",
    "dev:full:all": "bash Scripts/dev/full-local-stack.sh",
    "dev:firebase": "npx firebase emulators:start --only auth,firestore --project statly-4cbed",
    "dev:seed:local": "tsx Scripts/dev/seed-local-stack.ts",
    "dev:smoke:local": "tsx Scripts/dev/smoke-local-stack.ts",
    "dev:full:local": "bash Scripts/dev/full-local-stack.sh",
    "worker:dev": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && tsx --watch ./src/server/workers/enhancedDraftWorker.ts'",
    "worker:build": "tsc -p tsconfig.worker.json",
    "worker:start": "tsx ./src/server/workers/enhancedDraftWorker.ts",
    "draft-worker:dev": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && tsx --watch ./src/server/workers/enhancedDraftWorker.ts'",
    "draft-worker:start": "tsx ./src/server/workers/enhancedDraftWorker.ts",
    "web-vitals-worker:dev": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && tsx --watch ./src/server/workers/webVitalsWorker.ts'",
    "web-vitals-worker:start": "tsx ./src/server/workers/webVitalsWorker.ts",
    "clean": "rimraf .next dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:data": "tsc -p tsconfig.data.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm run typecheck:tests",
    "lint": "cross-env STATLY_LINT_ADVISORY=1 eslint src",
    "lint:changed": "node Scripts/ci/lint-changed.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "update:check": "npx npm-check-updates",
    "update:interactive": "npx npm-check-updates -u",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "cross-env PRISMA_HIDE_UPDATE_MESSAGE=1 prisma generate",
    "prisma:seed": "prisma db seed",
    "init-firebase-db": "tsx Scripts/initialize-firebase-db.ts",
    "check:etl": "tsx Scripts/check-etl-setup.ts",
    "player-data:dry-run": "tsx Scripts/player-data-convergence-dry-run.ts",
    "player-data:temp-db-runner": "tsx Scripts/player-data-convergence-temp-db-runner.ts",
    "player-data:temp-db-apply-simulation": "tsx Scripts/player-data-convergence-temp-db-apply-simulation.ts",
    "player-data:runner": "tsx Scripts/player-data-convergence-runner.ts",
    "player-identity:consolidate": "tsx Scripts/player-identity-consolidation.ts",
    "db:check": "tsx Scripts/check-database.ts",
    "firestore:smoke": "tsx Scripts/firestore-smoke.ts",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:int": "vitest run --config vitest.config.int.ts",
    "test:race": "vitest run --config vitest.config.race.ts",
    "test:all": "npm run lint:ci && npm run typecheck && npm run test:unit && npm run test:int && npm run test:race && npm run test:e2e",
    "lint:ci": "eslint . --quiet",
    "lint:strict": "eslint . --max-warnings=0",
    "pretest:e2e": "npm run auth-worker:build",
    "test:e2e": "playwright test",
    "pretest:e2e:headed": "npm run auth-worker:build",
    "test:e2e:headed": "playwright test --headed",
    "pretest:e2e:ui": "npm run auth-worker:build",
    "test:e2e:ui": "playwright test --ui",
    "dev:kill": "bash -lc 'pkill -f \"next dev\" || true; pkill -f \"tsx .*socketioServer\" || true; pkill -f \"tsx .*webVitalsWorker\" || true'",
    "dev:clean": "bash -lc 'rm -rf .next node_modules/.cache'",
    "dev:reset": "bash -lc 'npm run dev:kill && npm run dev:clean && npm run dev:full:all'",
    "queue:webvitals": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && tsx ./src/server/queue/webVitalsProducer.ts'",
    "dev:up": "concurrently -k -n web,socket,draft-worker -c blue,magenta,green \"npm:dev\" \"npm:socket\" \"npm:draft-worker:dev\"",
    "dev:down": "bash -lc 'pkill -f \"next dev\" || true; pkill -f \"tsx .*socketioServer\" || true; pkill -f \"tsx .*enhancedDraftWorker\" || true; pkill -f \"tsx .*webVitalsWorker\" || true'",
    "socket:only": "bash -lc 'NODE_ENV=development tsx -r dotenv/config ./src/server/socketioServer.ts'",
    "test:socket": "node scripts/dev/test-sio.mjs",
    "test:smoke:socket": "bash -lc '( NODE_ENV=development tsx -r dotenv/config ./src/server/socketioServer.ts & echo $! > .socket.pid ); sleep 2; node scripts/dev/test-sio.mjs; CODE=$?; ( kill $(cat .socket.pid) >/dev/null 2>&1 || true ); rm -f .socket.pid; exit $CODE'",
    "codex:branch": "bash -lc 'Scripts/codex/branch.sh \"$@\"'",
    "codex:commit": "bash -lc 'Scripts/codex/commit.sh \"$@\"'",
    "codex:push": "bash -lc 'Scripts/codex/push.sh'",
    "codex:pr": "bash -lc 'Scripts/codex/pr.sh \"$@\"'",
    "codex:land": "bash -lc 'Scripts/codex/land.sh \"$@\"'",
    "pr:checkout": "bash -lc 'Scripts/codex/checkout-pr.sh \"$@\"'",
    "codex:review": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && Scripts/codex/review.sh'",
    "codex:rewrite": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && Scripts/codex/rewrite.sh'",
    "codex:review:committed": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && Scripts/codex/review-against-main.sh'",
    "codex:review:branch": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && Scripts/codex/review-against-main.sh origin/main'",
    "codex:trigger": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && Scripts/codex/trigger-review.sh'",
    "codex:council": "node Scripts/codex/council.mjs",
    "codex:council:diff": "node Scripts/codex/council.mjs --diff",
    "codex:council:logical": "node Scripts/codex/council.mjs --provider logical",
    "codex:council:logical:diff": "node Scripts/codex/council.mjs --provider logical --diff",
    "codex:council:local": "node Scripts/codex/council.mjs --provider logical",
    "codex:council:local:diff": "node Scripts/codex/council.mjs --provider logical --diff",
    "codex:council:ollama": "node Scripts/codex/council.mjs --provider ollama",
    "codex:council:ollama:diff": "node Scripts/codex/council.mjs --provider ollama --diff",
    "codex:council:openrouter": "node Scripts/codex/council.mjs --provider openrouter",
    "codex:commit:reviewed": "node Scripts/codex/reviewed-commit.mjs"
  },
  "dependencies": {
    "@clickhouse/client": "^1.12.1",
    "@giphy/js-analytics": "5.0.0",
    "@giphy/js-fetch-api": "5.8.0",
    "@headlessui/react": "^2.2.7",
    "@hello-pangea/dnd": "^18.0.1",
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.68.0",
    "@sentry/react": "^10.68.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@tanstack/react-query": "^5.85.3",
    "axios": "^1.18.1",
    "bullmq": "^5.81.2",
    "chart.js": "^4.5.0",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.0",
    "daisyui": "^5.0.50",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "domhandler": "^5.0.3",
    "dotenv": "^17.2.1",
    "express": "^5.2.1",
    "firebase": "^12.16.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.4.0",
    "framer-motion": "^12.23.12",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.539.0",
    "openai": "^5.12.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.1",
    "react-window": "^1.8.11",
    "server-only": "0.0.1",
    "socket.io": "^4.8.3",
    "styled-components": "6.4.4",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "tailwind-scrollbar": "^4.0.2",
    "tsx": "^4.23.1",
    "use-sound": "^5.0.0",
    "uuid": "^11.1.1",
    "zod": "^4.0.17",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "1.60.0",
    "@storybook/react": "^9.1.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/react-window": "^1.8.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.0.0",
    "esbuild": "0.25.8",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.5.22",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "next": "15.5.22",
    "postcss": "^8.5.23",
    "postcss-nesting": "^13.0.2",
    "prettier": "^3.6.2",
    "prisma": "^6.19.3",
    "rimraf": "^6.0.1",
    "socket.io-client": "^4.8.3",
    "storybook": "^9.1.2",
    "tailwindcss": "^4.1.12",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "description": "This is a comprehensive fantasy sports platform for the Australian Football League (AFL), built with Next.js, React, TypeScript, and Firebase, featuring real-time player statistics and live scoring.",
