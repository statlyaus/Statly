    "date-fns-tz": "^3.2.0",
    "domhandler": "^5.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-xml-parser": "5.10.1",
    "fflate": "0.8.3",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^12.43.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.577.0",
    "openai": "^5.23.2",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-window": "^1.8.11",
    "read-excel-file": "9.3.5",
    "server-only": "0.0.1",
    "socket.io": "^4.8.3",
    "styled-components": "6.4.4",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-scrollbar": "^4.0.2",
    "tsx": "^4.23.1",
    "use-sound": "^5.0.0",
    "uuid": "^11.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.5",
    "@electric-sql/pglite-socket": "0.1.5",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.62.0",
    "@storybook/react": "^9.1.20",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-window": "^1.8.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "esbuild": "0.25.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "next": "16.2.12",
    "postcss": "^8.5.25",
    "postcss-nesting": "^13.0.2",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "rimraf": "^6.1.3",
    "socket.io-client": "^4.8.3",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  },
  "description": "This is a comprehensive fantasy sports platform for the Australian Football League (AFL), built with Next.js, React, TypeScript, and Firebase, featuring real-time player statistics and live scoring.",
