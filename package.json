{
  "name": "my-fantasy-afl-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "node Scripts/setup-git-hooks.mjs",
    "dev": "next dev --turbopack",
    "dev:app": "next dev --turbopack -p 3000",
    "build": "node Scripts/validate-env.cjs && next build",
    "build:production": "npm run build",
    "build:release": "BYPASS_AUTH=false NEXT_PUBLIC_BYPASS_AUTH=false node Scripts/validate-env.cjs && BYPASS_AUTH=false NEXT_PUBLIC_BYPASS_AUTH=false next build",
    "start": "node Scripts/validate-env.cjs && next start",
    "socket": "npm run dev:socket",
    "dev:inngest": "npx --yes --ignore-scripts=false inngest-cli@latest dev -u http://localhost:3000/api/inngest --no-discovery",
    "dev:with-inngest": "concurrently -k -n inngest,next,socket \"npm run dev:inngest\" \"INNGEST_DEV=1 npm run dev:app\" \"npm run socket\"",
    "dev:full": "concurrently -k -n next,socket,worker \"npm run dev:app\" \"npm run socket\" \"npm run worker:dev\"",
    "dev:with-worker": "concurrently -k -n next,worker \"npm run dev:app\" \"npm run worker:dev\"",
    "dev:full:all": "concurrently -k -n next,socket,worker \"npm run dev:app\" \"npm run socket\" \"npm run worker:dev\"",
    "dev:express": "tsx src/server/index.ts",
    "draft-worker:dev": "tsx --watch src/server/workers/draftWorkerDev.ts",
    "worker:dev": "npm run draft-worker:dev",
    "web-vitals-worker:build": "tsc -p tsconfig.worker.json && node Scripts/finalize-worker-build.cjs",
    "worker:build": "npm run web-vitals-worker:build",
    "web-vitals-worker:start": "node dist/server/workers/webVitalsWorkerEntry.js",
    "worker:start": "npm run web-vitals-worker:start",
    "clean": "rimraf .next dist",
    "typegen:next": "next typegen",
    "typecheck": "npm run typecheck:app && npm run typecheck:tests",
    "typecheck:app": "npm run typegen:next && tsc -p tsconfig.app.json --noEmit",
    "typecheck:data": "tsc -p tsconfig.data.json --noEmit",
    "typecheck:tests": "npm run typegen:next && tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm run typecheck:tests",
    "lint": "NODE_OPTIONS=\"--max-old-space-size=4096\" eslint --cache --cache-location .eslintcache src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "update:check": "npx npm-check-updates",
    "update:interactive": "npx npm-check-updates -u",
    "migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "init-firebase-db": "tsx Scripts/initialize-firebase-db.ts",
    "seed:auth": "tsx Scripts/seedAuthUsers.ts",
    "check:etl": "tsx Scripts/check-etl-setup.ts",
    "import:footywire-rounds": "tsx Scripts/import-footywire-rounds.ts",
    "db:check": "tsx Scripts/check-database.ts",
    "firestore:smoke": "tsx Scripts/firestore-smoke.ts",
    "verify-match-logs": "tsx scripts/verify-match-logs.ts",
    "import:draft-trades": "tsx Scripts/import-draft-trades.ts",
    "report:draft-club-scale": "tsx Scripts/report-draft-club-scale.ts",
    "bootstrap:league-season": "tsx Scripts/bootstrap-league-season.ts",
    "audit:league-rosters": "tsx Scripts/auditLeagueRosterOwnership.ts",
    "inngest:repair-draft": "tsx Scripts/emit-draft-repair.ts",
    "sync:player-clubs": "tsx Scripts/sync-player-clubs.ts",
    "precompute:season-stats": "node Scripts/precompute-season-stats.cjs",
    "build:player-read-models": "tsx Scripts/build-player-read-models.ts",
    "verify:player-read-models": "tsx Scripts/verify-player-read-models.ts",
    "env:check": "bash ./check-env-firebase.sh && node Scripts/check-env.cjs",
    "env:check:firebase": "bash ./check-env-firebase.sh",
    "guard:routes": "tsx scripts/check-next-route-runtime.ts && tsx scripts/check-route-runtime-admin.ts",
    "guard:secrets": "tsx scripts/scan-secrets.ts",
    "guard:tracked-artifacts": "node Scripts/check-tracked-local-artifacts.mjs",
    "guard:deps": "node scripts/forbid-server-imports.cjs",
    "setup:hooks": "node Scripts/setup-git-hooks.mjs",
    "prepush:ci": "npm run typecheck && npm run lint && npm run env:check:firebase && npm run guard:routes && npm run guard:tracked-artifacts && npm run guard:deps && npm test && npm run format:check",
    "prepush": "npm run prepush:ci",
    "prepush:full": "npm run typecheck && npm run lint && npm run env:check && npm run guard:routes && npm run guard:tracked-artifacts && npm run guard:deps && npm test && npm run format:check",
    "doctor": "npm run prepush:ci",
    "env:validate": "node Scripts/validate-env.cjs",
    "dev:socket": "tsx src/server/socketioServer.ts",
    "dev:socket:legacy": "node src/server/socket.cjs",
    "dev:all": "concurrently -k -n next,socket \"npm run dev:app\" \"npm:dev:socket\"",
    "emu": "firebase emulators:start --only firestore,auth --import ./.firebase-data --export-on-exit || npx firebase-tools emulators:start --only firestore,auth --import ./.firebase-data --export-on-exit",
    "emu:once": "firebase emulators:start --only firestore,auth --import ./.firebase-data",
    "emu:clean": "rimraf ./.firebase-data",
    "emu:ui": "open http://127.0.0.1:4002",
    "dev:emu": "concurrently -k -n emu,next \"npm run emu\" \"npm run dev:app\"",
    "dev:full:emu": "concurrently -k -n emu,next,socket \"npm run emu\" \"npm run dev:app\" \"npm run socket\"",
    "dev:full:emu:inngest": "concurrently -k -n inngest,emu,next,socket \"npm run dev:inngest\" \"npm run emu\" \"INNGEST_DEV=1 npm run dev:app\" \"npm run socket\"",
    "dev:stack": "concurrently -k -n inngest,emu,next,socket,worker \"npm run dev:inngest\" \"npm run emu\" \"INNGEST_DEV=1 npm run dev:app\" \"npm run socket\" \"npm run worker:dev\""
  },
  "dependencies": {
    "@clickhouse/client": "^1.12.1",
    "@headlessui/react": "2.2.8",
    "@hello-pangea/dnd": "^18.0.1",
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "6.16.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tanstack/react-query": "5.87.4",
    "@types/cheerio": "^1.0.0",
    "axios": "^1.11.0",
    "bullmq": "^5.58.5",
    "canvas-confetti": "^1.9.3",
    "chart.js": "^4.5.0",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "daisyui": "5.1.10",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "domhandler": "^5.0.3",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "firebase": "12.7.0",
    "firebase-admin": "13.6.0",
    "framer-motion": "^12.23.12",
    "inngest": "4.1.1",
    "ioredis": "^5.7.0",
    "lucide-react": "0.544.0",
    "openai": "5.20.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-chartjs-2": "^5.3.0",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-window": "2.2.3",
    "redis": "^5.8.2",
    "server-only": "^0.0.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "tailwind-scrollbar": "^4.0.2",
    "use-sound": "^5.0.0",
    "uuid": "^13.0.0",
    "zod": "4.1.8",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@eslint/js": "^9.39.2",
    "@storybook/react": "^9.1.5",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/jest": "29.5.14",
    "@types/node": "24.3.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "1.8.8",
    "@types/supertest": "^6.0.2",
    "@types/testing-library__jest-dom": "5.14.9",
    "@typescript-eslint/eslint-plugin": "8.43.0",
    "@typescript-eslint/parser": "8.43.0",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-next": "15.5.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "globby": "14.1.0",
    "jsdom": "^26.1.0",
    "next": "15.5.3",
    "postcss": "^8.5.6",
    "postcss-nesting": "^13.0.2",
    "prettier": "^3.7.4",
    "prisma": "6.16.1",
    "rimraf": "^6.1.2",
    "storybook": "^9.1.5",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.1.13",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.3.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.43.0",
    "vitest": "^3.2.4"
  },
  "description": "This is a comprehensive fantasy sports platform for the Australian Football League (AFL), built with Next.js, React, TypeScript, and Firebase, featuring real-time player statistics and live scoring.",
  "main": "check-data.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statlyaus/Statly.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/statlyaus/Statly/issues"
  },
  "homepage": "https://github.com/statlyaus/Statly#readme",
  "overrides": {
    "openai": {
      "zod": "^4.0.0"
    },
    "firebase-admin": {
      "@google-cloud/firestore": "7.11.0"
    }
  }
}
