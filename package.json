    "firebase-functions": "^6.4.0",
    "framer-motion": "^12.23.12",
    "ioredis": "^5.7.0",
    "lucide-react": "^0.539.0",
    "openai": "^5.12.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-chartjs-2": "^5.3.0",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-window": "^1.8.11",
    "server-only": "0.0.1",
    "socket.io": "^4.8.1",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "tailwind-scrollbar": "^4.0.2",
    "use-sound": "^5.0.0",
    "uuid": "^11.1.0",
    "zod": "^4.0.17",
    "zustand": "^5.0.7"
