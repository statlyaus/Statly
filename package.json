{
  "name": "my-fantasy-afl-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "auth-worker:build": "node Scripts/build-auth-service-worker.mjs",
    "predev": "npm run auth-worker:build",
    "dev": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && next dev'",
    "predev:webpack": "npm run auth-worker:build",
    "dev:webpack": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && next dev --webpack'",
    "predev:trace": "npm run auth-worker:build",
    "dev:trace": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && NEXT_TURBOPACK_TRACING=1 NEXT_PUBLIC_ENABLE_DEVELOPMENT_PERFORMANCE_ANALYTICS=true next dev'",
    "perf:dev:report": "node Scripts/dev/route-compilation-report.mjs",
    "perf:bundle": "next experimental-analyze -o",
    "prebuild": "cross-env NODE_ENV=production npm run auth-worker:build",
    "build": "npm run prisma:generate && cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "prebuild:production": "cross-env NODE_ENV=production npm run auth-worker:build",
    "build:production": "npm run prisma:generate && next build",
    "start": "next start",
    "socket": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && NODE_ENV=development tsx -r dotenv/config ./src/server/socketioServer.ts'",
    "dev:full": "concurrently \"npm run dev\" \"npm run socket\"",
    "dev:with-worker": "concurrently \"npm run dev\" \"npm run draft-worker:dev\"",
    "dev:full:all": "bash Scripts/dev/full-local-stack.sh",
    "dev:firebase": "npx --yes --package=firebase-tools@15.25.0 firebase emulators:start --only auth,firestore",
    "dev:outcomes-db": "tsx Scripts/dev/start-local-afl-trade-outcomes-db.ts",
    "dev:outcomes:seed": "tsx Scripts/dev/seed-local-afl-trade-outcomes.ts",
    "dev:seed:local": "tsx Scripts/dev/seed-local-stack.ts",
    "dev:smoke:local": "tsx Scripts/dev/smoke-local-stack.ts",
    "dev:full:local": "bash Scripts/dev/full-local-stack.sh",
    "worker:dev": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && tsx --watch ./src/server/workers/enhancedDraftWorker.ts'",
    "worker:build": "tsc -p tsconfig.worker.json",
    "worker:start": "tsx ./src/server/workers/enhancedDraftWorker.ts",
    "draft-worker:dev": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && tsx --watch ./src/server/workers/enhancedDraftWorker.ts'",
    "draft-worker:start": "tsx ./src/server/workers/enhancedDraftWorker.ts",
    "web-vitals-worker:dev": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && tsx --watch ./src/server/workers/webVitalsWorker.ts'",
    "web-vitals-worker:start": "tsx ./src/server/workers/webVitalsWorker.ts",
    "clean": "rimraf .next dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:data": "tsc -p tsconfig.data.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm run typecheck:tests",
    "lint": "cross-env STATLY_LINT_ADVISORY=1 eslint src",
    "lint:changed": "node Scripts/ci/lint-changed.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node Scripts/check-docs.mjs",
    "test": "vitest run",
    "update:check": "npx npm-check-updates",
    "update:interactive": "npx npm-check-updates -u",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "cross-env PRISMA_HIDE_UPDATE_MESSAGE=1 prisma generate",
    "prisma:seed": "prisma db seed",
    "outcomes:prisma:generate": "cross-env PRISMA_HIDE_UPDATE_MESSAGE=1 AFL_OUTCOMES_DATABASE_URL=postgresql://schema-only:schema-only@127.0.0.1:1/schema_only prisma generate --schema=prisma/afl-trade-outcomes/schema.prisma",
    "outcomes:prisma:validate": "cross-env AFL_OUTCOMES_DATABASE_URL=postgresql://schema-only:schema-only@127.0.0.1:1/schema_only prisma validate --schema=prisma/afl-trade-outcomes/schema.prisma",
    "outcomes:prisma:migrate:deploy": "prisma migrate deploy --schema=prisma/afl-trade-outcomes/schema.prisma",
    "outcomes:sources:record-approved": "tsx Scripts/record-approved-fitzroy-sources.ts",
    "outcomes:sources:record-approved-external": "tsx Scripts/record-approved-external-draft-trade-sources.ts",
    "outcomes:sources:ingest-fitzroy": "tsx Scripts/ingest-fitzroy-provider-season.ts",
    "outcomes:sources:ingest-external": "tsx Scripts/ingest-external-draft-trade-page.ts",
    "outcomes:sources:discover-external-history": "tsx Scripts/discover-external-draft-trade-history.ts",
    "outcomes:sources:run-external-history": "tsx Scripts/run-external-draft-trade-history.ts",
    "outcomes:sources:complete-external-history": "tsx Scripts/complete-external-draft-trade-history.ts",
    "outcomes:sources:export-external-identity-review": "tsx Scripts/export-external-identity-review-queue.ts",
    "outcomes:sources:record-external-identity-resolution": "tsx Scripts/record-external-identity-resolution.ts",
    "outcomes:sources:prepare-external-reconciliation": "tsx Scripts/prepare-external-draft-trade-reconciliation.ts",
    "outcomes:sources:review-external-promotion": "tsx Scripts/record-external-canonical-promotion-review.ts",
    "outcomes:sources:run-external-schedule": "tsx Scripts/run-external-draft-trade-schedule.ts",
    "outcomes:sources:dispatch-due-external": "tsx Scripts/dispatch-due-external-draft-trades.ts",
    "outcomes:sources:reconcile-external": "tsx Scripts/reconcile-external-draft-trade-evidence.ts",
    "outcomes:sources:promote-external": "tsx Scripts/promote-external-draft-trade-candidate.ts",
    "outcomes:publication:prepare-factual": "tsx Scripts/prepare-afl-trade-factual-publication.ts",
    "outcomes:publication:prepare-valuation": "tsx Scripts/prepare-afl-trade-valuation-publication.ts",
    "outcomes:publication:manage-valuation": "tsx Scripts/manage-afl-trade-valuation-publication.ts",
    "outcomes:modeling:materialize-pick-pav": "tsx Scripts/materialize-pick-pav-observations.ts",
    "init-firebase-db": "tsx Scripts/initialize-firebase-db.ts",
    "check:etl": "tsx Scripts/check-etl-setup.ts",
    "player-data:dry-run": "tsx Scripts/player-data-convergence-dry-run.ts",
    "player-data:temp-db-runner": "tsx Scripts/player-data-convergence-temp-db-runner.ts",
    "player-data:temp-db-apply-simulation": "tsx Scripts/player-data-convergence-temp-db-apply-simulation.ts",
    "player-data:runner": "tsx Scripts/player-data-convergence-runner.ts",
    "player-identity:consolidate": "tsx Scripts/player-identity-consolidation.ts",
    "db:check": "tsx Scripts/check-database.ts",
    "firestore:smoke": "tsx Scripts/firestore-smoke.ts",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:int": "vitest run --config vitest.config.int.ts",
    "test:outcomes:int": "tsx Scripts/dev/run-disposable-afl-trade-outcomes-tests.ts",
    "test:outcomes:int:provisioned": "vitest run --config vitest.config.outcomes-int.ts",
    "outcomes:workbook:inspect": "tsx Scripts/afl-outcomes-development-workbook.ts",
    "test:outcomes:workbook": "vitest run --config vitest.config.outcomes-workbook.ts",
    "test:outcomes:fitzroy-decode": "Rscript --vanilla etl/afl-trade-intelligence/test_decode_contract.R",
    "test:race": "vitest run --config vitest.config.race.ts",
    "test:all": "npm run lint:ci && npm run typecheck && npm run test:unit && npm run test:int && npm run test:e2e",
    "lint:ci": "cross-env NODE_OPTIONS=--max-old-space-size=4096 eslint . --quiet",
    "lint:strict": "eslint . --max-warnings=0",
    "pretest:e2e": "npm run auth-worker:build",
    "test:e2e": "playwright test --grep-invert @draft-worker",
    "pretest:e2e:draft-worker": "npm run auth-worker:build",
    "test:e2e:draft-worker": "cross-env PLAYWRIGHT_WITH_SOCKET=true PLAYWRIGHT_WITH_DRAFT_WORKER=true playwright test --grep @draft-worker --project=chromium",
    "pretest:e2e:headed": "npm run auth-worker:build",
    "test:e2e:headed": "playwright test --headed",
    "pretest:e2e:ui": "npm run auth-worker:build",
    "test:e2e:ui": "playwright test --ui",
    "dev:kill": "bash -lc 'pkill -f \"next dev\" || true; pkill -f \"tsx .*socketioServer\" || true; pkill -f \"tsx .*webVitalsWorker\" || true'",
    "dev:clean": "bash -lc 'rm -rf .next node_modules/.cache'",
    "dev:reset": "bash -lc 'npm run dev:kill && npm run dev:clean && npm run dev:full:all'",
    "queue:webvitals": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && tsx ./src/server/queue/webVitalsProducer.ts'",
    "dev:up": "concurrently -k -n web,socket,draft-worker -c blue,magenta,green \"npm:dev\" \"npm:socket\" \"npm:draft-worker:dev\"",
    "dev:down": "bash -lc 'pkill -f \"next dev\" || true; pkill -f \"tsx .*socketioServer\" || true; pkill -f \"tsx .*enhancedDraftWorker\" || true; pkill -f \"tsx .*webVitalsWorker\" || true'",
    "socket:only": "bash -lc 'NODE_ENV=development tsx -r dotenv/config ./src/server/socketioServer.ts'",
    "test:socket": "node scripts/dev/test-sio.mjs",
    "test:smoke:socket": "bash -lc '( NODE_ENV=development tsx -r dotenv/config ./src/server/socketioServer.ts & echo $! > .socket.pid ); sleep 2; node scripts/dev/test-sio.mjs; CODE=$?; ( kill $(cat .socket.pid) >/dev/null 2>&1 || true ); rm -f .socket.pid; exit $CODE'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1105.0",
    "@clickhouse/client": "^1.23.1",
    "@giphy/js-analytics": "5.0.0",
    "@giphy/js-fetch-api": "5.8.0",
    "@headlessui/react": "^2.2.10",
    "@hello-pangea/dnd": "^18.0.1",
    "@heroicons/react": "^2.2.0",
