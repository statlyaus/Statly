--- a/R/helpers-footywire.R
+++ b/R/helpers-footywire.R
@@ -153,9 +153,34 @@ footywire_html <- function(x, id) {
 #'
 #' @keywords internal
 #' @noRd
+footywire_read_html <- local({
+  last_completed <- -Inf
+  function(url) {
+    # Statly local control: one sequential FootyWire request, no implicit redirects or retries.
+    allowed <- "^https://www\\.footywire\\.com/afl/footy/(ft_match_list\\?year=[0-9]{4}|ft_match_statistics\\?mid=[0-9]+(&advv=Y)?)$"
+    if (!is.character(url) || length(url) != 1L || is.na(url) || !grepl(allowed, url)) {
+      stop("FootyWire request URL is outside the reviewed endpoints.")
+    }
+    remaining <- 3 - (unname(proc.time()[["elapsed"]]) - last_completed)
+    while (remaining > 0) {
+      Sys.sleep(remaining)
+      remaining <- 3 - (unname(proc.time()[["elapsed"]]) - last_completed)
+    }
+    # Update even when transport fails: a later call must not become an immediate retry.
+    on.exit(last_completed <<- unname(proc.time()[["elapsed"]]), add = TRUE)
+    response <- curl::curl_fetch_memory(url, handle = curl::new_handle(
+      followlocation = FALSE, connecttimeout = 10, timeout = 30
+    ))
+    if (response$status_code != 200L) {
+      stop("FootyWire HTTP request failed; redirects and retries are not followed.")
+    }
+    xml2::read_html(response$content)
+  }
+})
+
 get_match_data <- function(id) {
   # Create URL
-  default_url <- "http://www.footywire.com/afl/footy/ft_match_statistics?mid="
+  default_url <- "https://www.footywire.com/afl/footy/ft_match_statistics?mid="
   basic_url <- paste(default_url, id, sep = "")
   advanced_url <- paste(default_url, id, "&advv=Y", sep = "")
 
@@ -163,7 +188,7 @@ get_match_data <- function(id) {
 
   # Check if URL exists
   footywire_basic <- tryCatch(
-    xml2::read_html(basic_url),
+    footywire_read_html(basic_url),
     error = function(e) FALSE
   )
 
@@ -191,7 +216,7 @@ get_match_data <- function(id) {
 
       # Check if Advanced URL exists
       footywire_advanced <- tryCatch(
-        xml2::read_html(advanced_url),
+        footywire_read_html(advanced_url),
