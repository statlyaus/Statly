+footywire_player_links <- function(table) {
+  rows <- rvest::html_elements(table, xpath = "./tr | ./tbody/tr")
+  if (length(rows) < 2L) stop("FootyWire player table has no rows.")
+  vapply(rows[-1L], function(row) {
+    links <- rvest::html_elements(row, xpath = "./td[1]//a")
+    if (length(links) != 1L) stop("FootyWire player row requires one profile link.")
+    href <- rvest::html_attr(links, "href")
+    # Retain the pp- path segment used by Statly's FootyWire draft adapter.
+    allowed <- "^(https://www\\.footywire\\.com/afl/footy/|/afl/footy/)?pp-[a-z0-9]+(-[a-z0-9]+)*--[a-z0-9]+(-[a-z0-9]+)*$"
+    if (is.na(href) || !grepl(allowed, href)) stop("Invalid FootyWire player profile link.")
+    sub("^.*/", "", href)
+  }, character(1), USE.NAMES = FALSE)
+}
