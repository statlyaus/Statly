{
  "name": "statly-etl",
  "version": "1.0.0",
  "description": "ETL pipeline for AFL data ingestion using fitzRoy",
  "main": "ingestFootywire.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/etl/liveGuard.js",
    "dev": "ts-node liveGuard.ts",
    "fetch-manual": "Rscript fetch_fw_round.R",
    "process-data": "node dist/etl/processFootywireData.js",
    "validate": "node dist/etl/validateMatchData.js",
    "test-r": "Rscript fetch_fw_round.R 2025 18",
    "test-pipeline": "OUTFILE=/tmp/player_stats_fryzigg_test.json Rscript fetch_fw_round.R 2025 && cat /tmp/player_stats_fryzigg_test.json | node dist/etl/processFootywireData.js",
    "test-suite": "./test_pipeline.sh",
    "backfill-fryzigg": "bash backfill_fryzigg.sh",
    "backfill-matches": "node dist/etl/backfillMatchesFromStats.js",
    "cleanup-mock-stats": "node dist/etl/cleanupMockPlayerStats.js",
    "cleanup-mock-matches": "node dist/etl/cleanupMockMatches.js",
    "validate-fryzigg": "node dist/etl/validateFryziggBackfill.js",
    "docker-build": "docker build -t statly-etl .",
    "docker-run": "docker run --env-file .env statly-etl"
  },
  "dependencies": {
    "dotenv": "^17.4.1",
    "firebase-admin": "13.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "ts-node": "^10.9.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
