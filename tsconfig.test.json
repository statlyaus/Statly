{
  "extends": "./tsconfig.next.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"],
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "shared/**/*.ts",
    "src/types/**/*.d.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx",
    "src/testUtils/**/*.ts",
    "vitest.setup.*",
    "src/testUtils/setupTests.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
