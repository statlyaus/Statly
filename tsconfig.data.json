{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": [
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx",
    "src/services/**/*.ts",
    "src/services/**/*.tsx",
    "src/types/**/*.d.ts"
  ],
  "exclude": ["node_modules", ".next", "dist"]
}
