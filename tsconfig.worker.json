{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "noEmit": false,
    "declaration": false,
    "sourceMap": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "lib": ["ES2023"],
    "verbatimModuleSyntax": false,
    "allowJs": false,
    "isolatedModules": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "src/server/workers/webVitalsWorker.ts",
    "src/server/realtime/**/*.ts",
    "src/services/webVitalsPersistence.ts",
    "src/lib/logger.ts",
    "src/lib/firebaseAdmin.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "functions",
    "etl",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/lib/__tests__/**",
    "src/lib/**",
    "src/app/**",
    "src/components/**",
    "src/contexts/**",
    "src/pages/**"
  ]
}
