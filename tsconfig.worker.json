{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "src/server/workers/enhancedDraftWorker.ts",
    "src/server/workers/webVitalsWorker.ts",
    "src/**/*.d.ts"
  ],
  "exclude": ["node_modules", ".next", "dist", "functions", "etl", "src/**/*.test.ts"]
}
