# Public client config (browser)
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXX
NEXT_PUBLIC_USE_EMULATORS=false

# Server (admin) config
# Base64-encoded service account JSON (with \n newlines in private_key)
# Example: Linux: cat serviceAccountKey.json | base64 -w0 | macOS: cat serviceAccountKey.json | base64 | tr -d '\n' | Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes('serviceAccountKey.json'))
# CI note: Ensure private_key newlines are preserved; use -w0 or escape \n when setting env vars in pipelines.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Alternative: Individual Firebase service account fields (if not using base64 JSON above)
# Purpose: Can replace FIREBASE_SERVICE_ACCOUNT_JSON_BASE64 for environments that prefer individual keys
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Note: For FIREBASE_PRIVATE_KEY, preserve \n newlines or base64-encode the entire key to avoid parsing issues
INTERNAL_TASK_SECRET=
LOG_LEVEL=info
LEAGUE_REVALIDATE_SECONDS=3600

# JWT Secret for authentication
# Purpose: Used for signing and verifying JWT tokens
# When to change: Generate a new secure random string for each environment
# Example: Use openssl rand -base64 32 or similar to generate
JWT_SECRET=

# Optional
# Deprecated: internal fetches use relative URLs; keep unset
NEXT_PUBLIC_API_BASE_URL=
OPENAI_API_KEY=
# Optional: Base URL for OpenAI-compatible APIs
# Purpose: Point SDK to an alternative host (proxy/self-hosted/region endpoint)
# When to change: If using an API proxy or non-default OpenAI endpoint
# Example (include /v1 if your SDK expects full base): https://api.openai-proxy.example.com/v1
# Note: Some SDKs automatically append /v1. Avoid double-appending; leave empty to use default endpoint.
OPENAI_BASE_URL=
GITHUB_TOKEN=

# Sentry observability (optional; SDKs remain disabled when DSNs are empty)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.01
NEXT_PUBLIC_SENTRY_REPLAYS_ERROR_SAMPLE_RATE=1
# Privacy-sensitive: leave false unless product policy explicitly permits default PII capture
NEXT_PUBLIC_SENTRY_SEND_DEFAULT_PII=false
# Development only; ignored in production
NEXT_PUBLIC_SENTRY_DEBUG=false

# Prisma database URL
# For SQLite (local dev): file:./dev.db
# For Postgres (prod): postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
DATABASE_URL=

# Redis configuration (used by live draft engine, queues)
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
# Note: In Redis Cluster mode (using REDIS_CLUSTER_NODES), the DB index is ignored.
# Most Redis clusters only support DB 0.
REDIS_POOL_SIZE=10
REDIS_MAX_RETRIES=3
# Health check interval in seconds (e.g., 30)
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
# Set to 'false' to disable health checks
REDIS_HEALTH_CHECK=true

# Firebase emulators (optional; set when running local emulators)
# Values must be host:port only (no scheme like http://). Example: 127.0.0.1:8080
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Cluster mode (optional)
# REDIS_CLUSTER_NODES expects JSON: [{"host":"node1","port":6379},{"host":"node2","port":6379}]
# Wrap the JSON in single quotes to avoid .env parsing issues
REDIS_CLUSTER_NODES='[{"host":"node1","port":6379},{"host":"node2","port":6379}]'
