# Public client config (browser)
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXX

# Server (admin) config
# Base64-encoded service account JSON (with \n newlines in private_key)
# Example: Linux: cat serviceAccountKey.json | base64 -w0 | macOS: cat serviceAccountKey.json | base64 | tr -d '\n' | Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes('serviceAccountKey.json'))
# CI note: Ensure private_key newlines are preserved; use -w0 or escape \n when setting env vars in pipelines.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Optional
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
OPENAI_API_KEY=
# Optional: Base URL for OpenAI-compatible APIs
# Purpose: Point SDK to an alternative host (proxy/self-hosted/region endpoint)
# When to change: If using an API proxy or non-default OpenAI endpoint
# Example: https://api.openai-proxy.example.com (leave empty for default)
OPENAI_BASE_URL=
GITHUB_TOKEN=

# Prisma database URL
# For SQLite (local dev): file:./dev.db
# For Postgres (prod): postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require
DATABASE_URL=

# Redis configuration (used by live draft engine, queues)
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MAX_RETRIES=3
# Health check interval in seconds (e.g., 30) or milliseconds (>=1000)
REDIS_HEALTH_CHECK_INTERVAL=30
# Set to 'false' to disable health checks
REDIS_HEALTH_CHECK=true

# Cluster mode (optional)
# REDIS_CLUSTER_NODES expects JSON: [{"host":"node1","port":6379},{"host":"node2","port":6379}]
REDIS_CLUSTER_NODES=

