# Public client config (browser)
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXX

# Server (admin) config
# Base64-encoded service account JSON (with \n newlines in private_key)
# Example: Linux: cat serviceAccountKey.json | base64 -w0 | macOS: cat serviceAccountKey.json | base64 | tr -d '\n' | Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes('serviceAccountKey.json'))
# CI note: Ensure private_key newlines are preserved; use -w0 or escape \n when setting env vars in pipelines.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Optional
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_BASE_URL=  # Set your OpenAI-compatible base URL; leave empty to use the public API
GITHUB_TOKEN=

