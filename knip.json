{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "netlify/functions/*.{ts,mts}",
    "Scripts/**/*.{ts,mts,js,mjs,cjs}",
    "src/workers/**/*.ts",
    "src/scripts/**/*.ts"
  ],
  "ignore": [".claude/**", "etl/**", "functions/**", "tmp/**", "graphify-out/**"],
  "ignoreWorkspaces": ["etl", "functions"]
}
