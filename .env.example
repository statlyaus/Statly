# Example environment variables (Next.js)

# Server base URL
APP_BASE_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000

# Client base URL (for browser fetches)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4001

# Socket.IO port (prefer SOCKETIO_PORT; SOCKET_PORT kept for legacy scripts)
SOCKETIO_PORT=4001
# SOCKET_PORT=3002

# Firebase Admin: base64 of service account JSON (do not commit raw JSON)
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Optional analytics configuration
# METRICS_BACKEND=firestore
# METRICS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
# METRICS_COLLECTION=analytics_web_vitals

# Optional Redis (rate limiting / dedup best-effort)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_MAX_RETRIES=3

# Token used to access GitHub-hosted OpenAI models
GITHUB_TOKEN=

# Standard OpenAI API key (if using OpenAI directly)
OPENAI_API_KEY=
