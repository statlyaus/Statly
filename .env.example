# Statly local environment example
# Copy to .env.local. Keep real values and credentials out of Git.

# Application and database
DATABASE_URL=file:./dev.db
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Firebase Web SDK (public browser configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin / ETL (server-only; prefer workload identity in deployed environments)
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_CLOUD_PROJECT=

# Local Firebase emulators
NEXT_PUBLIC_USE_EMULATORS=false
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Development-only authentication/tools (both client and server opt-in are required)
NEXT_PUBLIC_STATLY_ENABLE_DEV_AUTH=false
STATLY_ENABLE_DEV_AUTH=false
STATLY_ENABLE_DEV_TOOLS=false

# Redis, queues, and realtime
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
SOCKET_PORT=3002
NEXT_PUBLIC_SOCKET_URL=http://localhost:3002
SOCKET_IO_CORS_ORIGINS=http://localhost:3000

# Server-only scheduled/internal endpoints
INTERNAL_TASK_SECRET=
CRON_SECRET=

# Optional telemetry
METRICS_BACKEND=firestore
METRICS_ALLOWED_ORIGINS=http://localhost:3000
METRICS_COLLECTION=analytics_web_vitals
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.01
NEXT_PUBLIC_SENTRY_REPLAYS_ERROR_SAMPLE_RATE=1
NEXT_PUBLIC_SENTRY_SEND_DEFAULT_PII=false
NEXT_PUBLIC_SENTRY_DEBUG=false

# Optional model-backed product features
GITHUB_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ETL selection (used from etl/.env when copied there)
SEASON=
ROUND=
