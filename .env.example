# Core server configuration
DATABASE_URL=<YOUR_DATABASE_URL>
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=<YOUR_NEXTAUTH_SECRET>
# Optional compatibility alias. The deploy script will use NEXTAUTH_SECRET when JWT_SECRET is unset.
# JWT_SECRET=<YOUR_JWT_SECRET>

# Public app URLs
NEXT_PUBLIC_API_URL=https://your-domain.com
APP_BASE_URL=https://your-domain.com

# Firebase web config (client)
NEXT_PUBLIC_FIREBASE_API_KEY=<YOUR_VALUE_HERE>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<YOUR_VALUE_HERE>
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<YOUR_VALUE_HERE>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<YOUR_VALUE_HERE>
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<YOUR_VALUE_HERE>
NEXT_PUBLIC_FIREBASE_APP_ID=<YOUR_VALUE_HERE>
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=<YOUR_VALUE_HERE>

# Firebase Admin (server). Use one supported shape.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=<YOUR_BASE64_SERVICE_ACCOUNT_JSON>
# Or use the triplet instead of FIREBASE_SERVICE_ACCOUNT_JSON_BASE64:
# FIREBASE_PROJECT_ID=<YOUR_VALUE_HERE>
# FIREBASE_CLIENT_EMAIL=<YOUR_VALUE_HERE>
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional production settings
# LOG_LEVEL=info

# Local-only flags. Do not enable in production.
# BYPASS_AUTH=false
# NEXT_PUBLIC_BYPASS_AUTH=false

# Optional: Firebase emulators (server, local only)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
